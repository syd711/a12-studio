<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox alignment="CENTER_LEFT" spacing="6.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.commons.components.SearchFieldController">
    <children>
        <TextField fx:id="searchField" prefWidth="160.0" promptText="Search" styleClass="search-field" />
        <Button fx:id="resetSearchButton" accessibleText="Clear search" mnemonicParsing="false" onAction="#onResetSearch" styleClass="default-button">
            <graphic>
                <FontIcon iconLiteral="mdi2c-close" iconSize="14" styleClass="toolbar-icon" />
            </graphic>
            <tooltip>
                <Tooltip text="Clear search" />
            </tooltip>
        </Button>
    </children>
</HBox>
