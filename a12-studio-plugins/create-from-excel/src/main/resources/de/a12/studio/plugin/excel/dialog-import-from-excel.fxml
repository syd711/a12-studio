<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="560.0"
            styleClass="navigation-panel" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.plugin.excel.ImportFromExcelDialogController">
   <top>
      <fx:include fx:id="header" source="/de/a12/studio/ui/components/scene-dialog-header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll-pane" BorderPane.alignment="TOP_LEFT">
      <content>
      <VBox spacing="0.0">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>

         <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" />

         <!-- File chooser row -->
         <Label styleClass="field-label" text="%import_excel.file" />
         <HBox spacing="8.0" alignment="CENTER_LEFT">
            <VBox.margin><Insets top="4.0" /></VBox.margin>
            <TextField fx:id="filePathField" HBox.hgrow="ALWAYS" editable="false"
                       promptText="%import_excel.no_file_selected" styleClass="field-value">
               <font><Font size="13.0" /></font>
            </TextField>
            <Button fx:id="browseButton" mnemonicParsing="false" onAction="#onBrowse"
                    styleClass="secondary-button" text="%import_excel.browse">
               <graphic>
                  <FontIcon iconLiteral="mdi2f-folder-open-outline" iconSize="16" styleClass="button-icon" />
               </graphic>
               <tooltip><Tooltip text="%import_excel.browse_tooltip" /></tooltip>
            </Button>
         </HBox>

         <!-- Column list -->
         <Label styleClass="field-label" text="%import_excel.columns">
            <VBox.margin><Insets top="14.0" /></VBox.margin>
         </Label>
         <Label styleClass="field-hint" text="%import_excel.columns_hint">
            <VBox.margin><Insets top="2.0" bottom="4.0" /></VBox.margin>
         </Label>
         <ListView fx:id="columnListView" prefHeight="160.0" maxWidth="1.7976931348623157E308">
            <VBox.margin><Insets top="2.0" /></VBox.margin>
         </ListView>

         <!-- Model name -->
         <Label styleClass="field-label" text="%import_excel.model_name">
            <VBox.margin><Insets top="14.0" /></VBox.margin>
         </Label>
         <TextField fx:id="modelNameField" promptText="%import_excel.model_name_prompt">
            <VBox.margin><Insets top="4.0" /></VBox.margin>
            <font><Font size="14.0" /></font>
         </TextField>

         <!-- Location -->
         <Label styleClass="field-label" text="%location">
            <VBox.margin><Insets top="14.0" /></VBox.margin>
         </Label>
         <ComboBox fx:id="locationCombo" maxWidth="1.7976931348623157E308" promptText="%select_a_location">
            <VBox.margin><Insets top="4.0" /></VBox.margin>
         </ComboBox>

         <VBox spacing="24.0">
            <VBox.margin><Insets top="24.0" /></VBox.margin>
            <fx:include fx:id="locales" source="/de/a12/studio/ui/editors/propertyeditors/locales-panel.fxml" />
            <fx:include fx:id="roles" source="/de/a12/studio/ui/editors/propertyeditors/roles-panel.fxml" />
         </VBox>
      </VBox>
      </content>
      </ScrollPane>
   </center>
   <bottom>
      <ToolBar nodeOrientation="RIGHT_TO_LEFT" prefHeight="40.0" styleClass="footer-toolbar"
               BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false"
                    onAction="#onDialogSubmit" styleClass="primary-button"
                    text="%import_excel.create_button" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false"
                    onAction="#onDialogCancel" styleClass="secondary-button" text="%cancel" />
         </items>
      </ToolBar>
   </bottom>
</BorderPane>
