<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.plugin.applicationgroups.ApplicationGroupsPanelController">
    <top>
        <VBox BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label styleClass="preference-title" text="%project_settings" />
                <Label styleClass="preference-subtitle" text="%application_groups.subtitle" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" left="12.0" top="12.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="3.0" BorderPane.alignment="TOP_LEFT">
            <children>
            <VBox spacing="3.0">
               <children>
                      <CheckBox fx:id="useApplicationGroupsCheckBox" text="%application_groups.use_checkbox" />
                      <Label styleClass="field-description" wrapText="true" text="%application_groups.description" />
               </children>
            </VBox>
            <VBox>
               <children>
                      <Label styleClass="field-label" text="%application_groups.name_label" />
                      <TextField fx:id="applicationGroupNameField" prefWidth="280.0" promptText="%application_groups.name_prompt" />
               </children>
               <VBox.margin>
                  <Insets left="22.0" top="12.0" />
               </VBox.margin>
            </VBox>
            <VBox alignment="CENTER_RIGHT">
               <children>
                  <Button fx:id="applyBtn" mnemonicParsing="false" onAction="#onApplicationGroupApply" styleClass="primary-button" text="%application_groups.apply_button" >
                <tooltip><Tooltip text="%application_groups.apply_tooltip" /></tooltip>
            </Button>
               </children>
            </VBox>
            </children>
            <padding>
                <Insets left="12.0" right="12.0" top="8.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
