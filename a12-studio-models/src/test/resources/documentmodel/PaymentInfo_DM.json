                      "locale": "en",
                      "text": "Method of Payment"
                    },
                    {
                      "locale": "de",
                      "text": "Zahlungsmethode"
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_8ff43",
                "name": "MethodOfPaymentCreditCard",
                "Rule": {
                  "errorEntityRelPath": "../MethodOfPayment",
                  "errorCode": "Error rule_8ff43",
                  "errorCondition": "GroupFilled(CreditCard) AND [MethodOfPayment] != \"credit\"",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "Please do not give credit card information, if you did not choose credit card as a method of payment."
                    },
                    {
                      "locale": "de",
                      "text": "Bitte geben Sie keine Kreditkarteninformationen an, wenn Sie nicht die Kreditkarte als Bezahlmethode gewählt haben."
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_4bdfc",
                "name": "MethodOfPaymentDirectDebit",
                "Rule": {
                  "errorEntityRelPath": "../MethodOfPayment",
                  "errorCode": "Error rule_4bdfc",
                  "errorCondition": "GroupFilled(DirectDebit) AND GroupFilled(RuleGroup) AND [MethodOfPayment] != \"debit\"",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "Please do not give direct debit information, if you did not choose direct debit as a method of payment."
                    },
                    {
                      "locale": "de",
                      "text": "Bitte geben Sie keine Bankinformationen an, wenn Sie nicht den Bankeinzug als Bezahlmethode gewählt haben."
                    }
                  ]
                }
              },
