                          "value": "true"
                        }
                      ],
                      "Field": {
                        "fieldType": {
                          "type": "StringType",
                          "StringType": {
                            "errorMessage": [
                              {
                                "locale": "en",
                                "text": "The approval number must consist of three digits."
                              },
                              {
                                "locale": "de",
                                "text": "Die Prüfnummer muss aus drei Ziffern bestehen."
                              }
                            ],
                            "pattern": "[0-9]{3}"
                          }
                        },
                        "label": [
                          {
                            "locale": "en",
                            "text": "Approval Number"
                          },
                          {
                            "locale": "de",
                            "text": "Prüfnummer"
