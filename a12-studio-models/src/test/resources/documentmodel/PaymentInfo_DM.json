                    },
                    {
                      "type": "Field",
                      "id": "field_238df",
                      "name": "DueDate",
                      "Field": {
                        "fieldType": {
                          "type": "DateType",
                          "DateType": {
                            "format": "yyyy-MM-dd"
                          }
                        },
                        "label": [
                          {
                            "locale": "en",
                            "text": "Valid Until"
                          },
                          {
                            "locale": "de",
                            "text": "Gültigkeit"
                          }
                        ]
                      }
                    },
                    {
                      "type": "Rule",
                      "id": "rule_bc4aa",
                      "name": "CreditCardValid",
                      "Rule": {
                        "errorEntityRelPath": "../DueDate",
                        "errorCode": "Error rule_bc4aa",
                        "errorCondition": "FieldFilled(DueDate) and [DueDate] < Today",
                        "severity": "ERROR",
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "Your credit card is not valid anymore."
                          },
                          {
                            "locale": "de",
                            "text": "Die Gültigkeit Ihrer Kreditkarte ist abgelaufen."
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_aeada",
                "name": "CompleteCreditCardInformation",
                "Rule": {
                  "errorEntityRelPath": "../MethodOfPayment",
                  "errorCode": "Error rule_aeada",
                  "errorCondition": "FieldFilled(MethodOfPayment) and [MethodOfPayment]==\"credit\" and NotAllFieldsFilled(CreditCard)",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "Please enter the complete credit card information."
                    },
                    {
                      "locale": "de",
                      "text": "Bitte gaben Sie alle Informationen zu Ihrer Kreditkarte an."
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_7321f",
                "name": "CompleteDirectDebitInformation",
                "Rule": {
                  "errorEntityRelPath": "../MethodOfPayment",
                  "errorCode": "Error rule_7321f",
                  "errorCondition": "FieldFilled(MethodOfPayment) and [MethodOfPayment]==\"debit\" and NotAllFieldsFilled(DirectDebit)",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "Please enter your complete direct debit information."
                    },
                    {
                      "locale": "de",
                      "text": "Bitte gaben Sie alle Informationen zu Ihrer Bankverbindung an."
                    }
                  ]
                }
