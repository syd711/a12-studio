                                "text": "The credit card number must contain 16 digits."
                              },
                              {
                                "locale": "de",
                                "text": "Die Kreditkartennummer muss aus 16 Ziffern bestehen."
                              }
                            ],
                            "pattern": "[0-9]{16}"
                          }
                        },
                        "label": [
                          {
                            "locale": "en",
                            "text": "Credit Card Number"
                          },
                          {
                            "locale": "de",
                            "text": "Kreditkartennummer"
