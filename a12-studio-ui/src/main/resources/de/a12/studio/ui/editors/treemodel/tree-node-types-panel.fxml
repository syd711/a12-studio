<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%node_types" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeNodeTypesPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <!-- Left/right padding of 13 = the .module-row border (1) + padding (12), so header cells line up with the row cells.
         Fixed widths must match TreeNodeTypesPanelController.createRow(); the trailing spacer stands in for the row's actions box. -->
    <HBox fx:id="nodeHeaders" spacing="10.0">
      <padding><Insets left="13.0" right="13.0" /></padding>
      <Label styleClass="field-label" text="" minWidth="18.0" prefWidth="18.0" maxWidth="18.0" />
      <Label styleClass="field-label" text="%document_model" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      <Label styleClass="field-label" text="%drag_drop" minWidth="130.0" prefWidth="130.0" maxWidth="130.0" />
      <Region minWidth="120.0" prefWidth="120.0" maxWidth="120.0" />
    </HBox>
    <VBox fx:id="nodeRows" spacing="8.0" />
    <Label fx:id="nodesEmptyLabel" styleClass="placeholder-label" text="%no_node_types_defined" />
    <HBox spacing="8.0">
      <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="%add_node_type">
        <graphic><FontIcon styleClass="button-icon" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
        <tooltip><Tooltip text="%add_node_type" /></tooltip>
      </Button>
    </HBox>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
