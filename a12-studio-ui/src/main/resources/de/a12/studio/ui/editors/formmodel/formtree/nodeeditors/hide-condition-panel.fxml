<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@../../../../stylesheet.css" text="%hide_condition" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.HideConditionPanelController">
    <BorderPane>
        <center>
            <VBox spacing="8.0">
                <Label styleClass="field-label" text="%hide_condition_field" />
                <ComboBox fx:id="fieldCombo" maxWidth="Infinity" />
                <Label styleClass="field-label" text="%hide_condition_value" />
                <ComboBox fx:id="valueCombo" maxWidth="Infinity" />
                <padding>
                    <Insets top="4.0" />
                </padding>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
