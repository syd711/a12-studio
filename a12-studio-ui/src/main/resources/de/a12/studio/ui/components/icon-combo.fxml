<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" spacing="6.0" maxWidth="Infinity" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.a12.studio.ui.components.IconComboController">
    <children>
        <Label fx:id="previewLabel" alignment="CENTER" minWidth="24.0" prefWidth="24.0" />
        <ComboBox fx:id="iconCombo" editable="true" maxWidth="Infinity" promptText="%start_typing_an_icon_name" HBox.hgrow="ALWAYS" />
    </children>
</HBox>
