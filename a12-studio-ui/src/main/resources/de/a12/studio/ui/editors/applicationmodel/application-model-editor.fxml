<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane resources="@/messages" stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.applicationmodel.ApplicationModelEditorController">
    <fx:define>
        <VBox fx:id="editorContainer" prefWidth="100.0" />
    </fx:define>
    <right>
        <ToolBar orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <fx:include fx:id="settingsToolbarButton" source="../editor-settings-toolbar-button.fxml" />
                <Separator prefHeight="0.0" prefWidth="0.0" />
                <Button mnemonicParsing="false" onAction="#onPreview" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2e-eye-outline" iconSize="18" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="%preview" />
                    </tooltip>
                </Button>
                <Separator prefHeight="0.0" prefWidth="0.0" />
                <fx:include fx:id="fileToolbarButtons" source="../editor-file-toolbar-buttons.fxml" />
            </items>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </ToolBar>
    </right>
   <center>
      <SplitPane fx:id="splitPane" dividerPositions="0.5" BorderPane.alignment="CENTER">
         <items>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="properties-panel">
               <content>
                  <VBox spacing="12.0" styleClass="field-editor">
                     <children>
                        <fx:include fx:id="region" source="region-panel.fxml" />
                        <fx:include fx:id="subregions" source="subregions-panel.fxml" />
                        <fx:include fx:id="layout" source="layout-panel.fxml" />
                        <fx:include fx:id="modules" source="modules-panel.fxml" />
                        <fx:include fx:id="activity" source="activity-panel.fxml" />
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </VBox>
               </content>
            </ScrollPane>
         </items>
      </SplitPane>
   </center>
</BorderPane>
