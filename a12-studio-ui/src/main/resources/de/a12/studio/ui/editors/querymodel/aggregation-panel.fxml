<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%aggregation"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.querymodel.QueryAggregationPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="12.0">
                <children>
                    <CheckBox fx:id="aggregateResultsField" mnemonicParsing="false" text="%aggregate_results">
                        <tooltip>
                            <Tooltip prefWidth="360.0" text="%query_aggregation.aggregate_results_hint" wrapText="true" />
                        </tooltip>
                    </CheckBox>

                    <!-- The aggregation's own findings (QueryAggregationValidator); the top container above is the
                         AbstractPropertyEditor one, which stays hidden for a model-header panel. -->
                    <fx:include fx:id="problemsContainer" source="/de/a12/studio/ui/components/error-container.fxml" />


                    <VBox fx:id="aggregationBox" spacing="16.0">
                        <children>
                            <Label styleClass="placeholder-label" text="%query_aggregation.sort_paging_ignored" wrapText="true" />

                            <!-- Group Documents in Result By -->
                            <VBox spacing="8.0">
                                <children>
                                    <Label styleClass="section-header" text="%query_aggregation.group_title" />
                                    <Label fx:id="groupEmptyLabel" styleClass="placeholder-label" text="%query_aggregation.no_group" wrapText="true" />
                                    <VBox fx:id="groupRows" spacing="8.0" />
                                    <Button fx:id="addGroupButton" mnemonicParsing="false" onAction="#onAddGroup" styleClass="primary-button" text="%query_aggregation.add_group">
                                        <graphic>
                                            <FontIcon iconLiteral="mdi2p-plus" iconSize="16" styleClass="button-icon" />
                                        </graphic>
                                    </Button>
                                </children>
                            </VBox>

                            <!-- Aggregations for Grouped Result -->
                            <VBox spacing="8.0">
                                <children>
                                    <Label styleClass="section-header" text="%query_aggregation.aggregations_title" />
                                    <HBox fx:id="aggregationsHeaderRow" spacing="10.0">
                                        <children>
                                            <Label styleClass="field-label" prefWidth="140.0" text="%query_aggregation.function" />
                                            <Label styleClass="field-label" prefWidth="320.0" text="%field" />
                                            <Label styleClass="field-label" prefWidth="160.0" text="%alias" />
                                        </children>
                                    </HBox>
                                    <Label fx:id="aggregationsEmptyLabel" styleClass="placeholder-label" text="%query_aggregation.no_aggregations" />
                                    <VBox fx:id="aggregationRows" spacing="8.0" />
                                    <Button fx:id="addAggregationButton" mnemonicParsing="false" onAction="#onAddAggregation" styleClass="primary-button" text="%query_aggregation.add_aggregation">
                                        <graphic>
                                            <FontIcon iconLiteral="mdi2p-plus" iconSize="16" styleClass="button-icon" />
                                        </graphic>
                                    </Button>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
