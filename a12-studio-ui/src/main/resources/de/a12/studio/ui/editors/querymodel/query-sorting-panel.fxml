<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%sorting_query"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.querymodel.QuerySortingPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="10.0">
                <children>
                    <!-- Left inset = .module-row's 12px padding + 1px border, so header columns line up with the rows below. -->
                    <HBox fx:id="sortingHeaderRow" spacing="10.0" style="-fx-padding: 0 0 0 13;">
                        <children>
                            <Label styleClass="field-label" minWidth="18.0" prefWidth="18.0" maxWidth="18.0" text="" />
                            <Label styleClass="field-label" minWidth="220.0" prefWidth="220.0" maxWidth="220.0" text="%relationship_traversal" />
                            <Label styleClass="field-label" minWidth="200.0" prefWidth="200.0" maxWidth="200.0" text="%field" />
                            <Label styleClass="field-label" minWidth="110.0" prefWidth="110.0" maxWidth="110.0" text="%direction" />
                            <Label styleClass="field-label" minWidth="90.0" prefWidth="90.0" maxWidth="90.0" text="%ignore_case" />
                            <Label styleClass="field-label" minWidth="140.0" prefWidth="140.0" maxWidth="140.0" text="%null_handling" />
                        </children>
                    </HBox>
                    <VBox fx:id="sortingRows" spacing="8.0" />
                    <Label fx:id="sortingEmptyLabel" styleClass="placeholder-label" text="%no_sorting_defined" />
                    <Button mnemonicParsing="false" onAction="#onAddSort" styleClass="primary-button" text="%add_sort_entry">
                        <graphic>
                            <FontIcon iconLiteral="mdi2p-plus" iconSize="16" styleClass="button-icon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="%add_sort_entry" />
                        </tooltip>
                    </Button>
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
