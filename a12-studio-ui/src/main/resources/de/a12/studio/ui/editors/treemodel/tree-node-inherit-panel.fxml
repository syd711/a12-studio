<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%tree_node_inherit_panel.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeNodeInheritPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="8.0">
                <children>
                    <Label styleClass="placeholder-label" text="%tree_node_inherit_panel.hint" wrapText="true" />
                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        </columnConstraints>
                        <children>
                            <CheckBox wrapText="true" fx:id="columnsField" mnemonicParsing="false" text="%tree_node_inherit_panel.columns" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <CheckBox wrapText="true" fx:id="childRelationshipConfigurationsField" mnemonicParsing="false" text="%tree_node_inherit_panel.child_relationship_configurations" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <CheckBox wrapText="true" fx:id="iconField" mnemonicParsing="false" text="%tree_node_inherit_panel.icon" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <CheckBox wrapText="true" fx:id="actionsField" mnemonicParsing="false" text="%tree_node_inherit_panel.actions" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                            <CheckBox wrapText="true" fx:id="contextMenuField" mnemonicParsing="false" text="%tree_node_inherit_panel.context_menu" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <CheckBox wrapText="true" fx:id="defaultRowActionField" mnemonicParsing="false" text="%tree_node_inherit_panel.default_row_action" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            <CheckBox wrapText="true" fx:id="rowTitleField" mnemonicParsing="false" text="%tree_node_inherit_panel.row_title" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <CheckBox wrapText="true" fx:id="stylesField" mnemonicParsing="false" text="%tree_node_inherit_panel.styles" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        </children>
                    </GridPane>
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
