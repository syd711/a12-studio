<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%columns" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.overviewmodel.OverviewColumnsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="columnHeaders" spacing="10.0">
      <Label styleClass="field-label" text="" prefWidth="18.0" />
      <Label styleClass="field-label" text="%field" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      <Label styleClass="field-label" text="%sortable" prefWidth="70.0" />
      <Label styleClass="field-label" text="%width" prefWidth="70.0" />
      <Label styleClass="field-label" text="%pin_direction" prefWidth="240.0" />
    </HBox>
    <VBox fx:id="columnRows" spacing="8.0" />
    <Label fx:id="columnsEmptyLabel" styleClass="placeholder-label" text="%no_columns_defined" />
    <HBox  alignment="CENTER_LEFT" spacing="24.0">
        <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="%add" >
                <tooltip><Tooltip text="%add_column" /></tooltip>
            </Button>
      <CheckBox fx:id="enableColumnsResizeField" mnemonicParsing="false" text="%enable_columns_resize" />
      <HBox alignment="CENTER_LEFT" spacing="6.0">
        <CheckBox fx:id="showRowCountField" mnemonicParsing="false" text="%show_number_of_entries" />
        <Label prefHeight="9.0" prefWidth="7.0">
          <tooltip>
            <Tooltip prefWidth="300.0" text="%number_of_entries_is_not_displayed_if_the_model_label_is_hid" wrapText="true" />
          </tooltip>
          <graphic>
            <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
          </graphic>
        </Label>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="6.0">
        <CheckBox fx:id="skipInitialLoadField" mnemonicParsing="false" text="%skip_initial_load" />
        <Label prefHeight="9.0" prefWidth="7.0">
          <tooltip>
            <Tooltip prefWidth="300.0" text="%prevents_the_overview_from_querying_data_services_until_the_" wrapText="true" />
          </tooltip>
          <graphic>
            <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
          </graphic>
        </Label>
      </HBox>
    </HBox>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
