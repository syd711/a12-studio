<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="COLUMNS" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.overviewmodel.OverviewColumnsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="columnHeaders" spacing="10.0">
      <Label styleClass="field-label" text="" prefWidth="18.0" />
      <Label styleClass="field-label" text="Field" prefWidth="250.0" />
      <Label styleClass="field-label" text="Sortable" prefWidth="70.0" />
      <Label styleClass="field-label" text="Width" prefWidth="70.0" />
      <Label styleClass="field-label" text="Pin Direction" prefWidth="100.0" />
    </HBox>
    <VBox fx:id="columnRows" spacing="8.0" />
    <Label fx:id="columnsEmptyLabel" styleClass="placeholder-label" text="No columns defined." />
    <HBox  alignment="CENTER_LEFT" spacing="24.0">
        <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="Add" />
      <CheckBox fx:id="enableColumnsResizeField" mnemonicParsing="false" text="Enable Columns Resize" />
      <HBox alignment="CENTER_LEFT" spacing="6.0">
        <CheckBox fx:id="showRowCountField" mnemonicParsing="false" text="Show Number Of Entries" />
        <Label prefHeight="9.0" prefWidth="7.0">
          <tooltip>
            <Tooltip prefWidth="300.0" text="Number of Entries is not displayed if the model label is hidden or empty." wrapText="true" />
          </tooltip>
          <graphic>
            <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
          </graphic>
        </Label>
      </HBox>
      <HBox alignment="CENTER_LEFT" spacing="6.0">
        <CheckBox fx:id="skipInitialLoadField" mnemonicParsing="false" text="Skip Initial Load" />
        <Label prefHeight="9.0" prefWidth="7.0">
          <tooltip>
            <Tooltip prefWidth="300.0" text="Prevents the overview from querying Data Services until the user applies a filter or search. The overview shows an empty table until constraints are provided." wrapText="true" />
          </tooltip>
          <graphic>
            <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
          </graphic>
        </Label>
      </HBox>
    </HBox>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
