<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.border"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <SettingGroup types="Box,ListItem,OrderedList,UnorderedList,Image,Button,ButtonGroup">
            <ToggleRow path="style.borderStyle" initial="none">
                <ToggleOption value="none" label="%content_settings.none"/>
                <ToggleOption value="solid" label="%content_settings.solid"/>
                <ToggleOption value="dashed" label="%content_settings.dashed"/>
                <ToggleOption value="dotted" label="%content_settings.dotted"/>
            </ToggleRow>
            <LengthRow label="%content_settings.border_width" path="style.borderWidth" keywords="auto" units="px:1" showWhen="style.borderStyle=solid|dashed|dotted"/>
            <ColorRow label="%content_settings.color" path="style.borderColor" showWhen="style.borderStyle=solid|dashed|dotted"/>
            <SpacingRow label="%content_settings.border_radius" path="style.borderRadius" corners="true" units="px:0,%:0,rem:0" showWhen="style.borderStyle=solid|dashed|dotted"/>
            </SettingGroup>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
