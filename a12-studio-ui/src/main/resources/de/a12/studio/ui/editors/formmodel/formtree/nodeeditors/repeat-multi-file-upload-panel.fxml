<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            text="%repeat_multi_file_upload" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.RepeatMultiFileUploadPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="10.0">
                <CheckBox fx:id="enableCheckBox" mnemonicParsing="false" text="%multi_file_upload_enable" />
                <VBox fx:id="optionsBox" spacing="10.0">
                    <VBox spacing="2.0">
                        <Label styleClass="field-label" text="%multi_file_upload_attachment_group" />
                        <Label fx:id="attachmentGroupValueLabel" wrapText="true" />
                    </VBox>
                    <CheckBox fx:id="enableDownloadCheckBox" mnemonicParsing="false" text="%multi_file_upload_enable_download" />
                    <fx:include fx:id="description" source="../../../propertyeditors/localized-text-panel.fxml" />
                    <CheckBox fx:id="hideDescriptionCheckBox" mnemonicParsing="false" text="%multi_file_upload_hide_description" />
                    <fx:include fx:id="buttonText" source="../../../propertyeditors/localized-text-panel.fxml" />
                    <CheckBox fx:id="hideButtonTextCheckBox" mnemonicParsing="false" text="%multi_file_upload_hide_button_text" />
                    <fx:include fx:id="helperText" source="../../../propertyeditors/localized-text-panel.fxml" />
                </VBox>
                <padding>
                    <Insets bottom="4.0" top="4.0" />
                </padding>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
