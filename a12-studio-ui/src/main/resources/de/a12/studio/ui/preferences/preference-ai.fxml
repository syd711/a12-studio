<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.preferences.PreferenceAiController">
    <top>
        <VBox BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label styleClass="preference-title" text="%project_settings" />
                <Label styleClass="preference-subtitle" text="%ai_settings" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" left="12.0" top="12.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="6.0" BorderPane.alignment="TOP_LEFT">
            <children>
            <Label styleClass="field-label" text="%claude_support" />
                <CheckBox fx:id="claudeConsoleButtonCheckBox" text="%add_claude_console_button_to_the_menu_bar" />

                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="field-label" text="%claude_executable">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin></Label>
                        <RadioButton fx:id="openFromPathRadioButton" text="%open_from_path">
                            <toggleGroup>
                                <ToggleGroup fx:id="claudePathToggleGroup" />
                            </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="configurePathRadioButton" text="%configure_path" toggleGroup="$claudePathToggleGroup" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <TextField fx:id="claudePathField" prefWidth="360.0" promptText="%configure_the_path_to_the_claude_exe_here" />
                                <Button fx:id="claudePathBrowseButton" onAction="#onBrowseClaudePath" styleClass="primary-button" text="%browse" >
                <tooltip><Tooltip text="%browse_for_claude_executable" /></tooltip>
            </Button>
                            </children>
                     <VBox.margin>
                        <Insets left="22.0" />
                     </VBox.margin>
                        </HBox>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets left="12.0" right="12.0" top="8.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
