<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<TabPane stylesheets="@/de/a12/studio/ui/stylesheet.css" styleClass="sub-tab-panel" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.FormNodeEditorScreenPanelController">
    <tabs>
        <Tab text="%screen">
            <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="properties-panel">
                    <content>
                        <VBox spacing="12.0" styleClass="field-editor">
                            <children>
                                <fx:include fx:id="name" source="../../name-panel.fxml" />
                                <fx:include fx:id="label" source="../../../propertyeditors/localized-text-type-panel.fxml" />
                                <fx:include fx:id="annotations" source="../../../propertyeditors/annotations-panel.fxml" />
                            </children>
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </content>
        </Tab>
        <Tab text="%subheader_and_footer">
            <content>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="properties-panel">
                    <content>
                        <VBox spacing="12.0" styleClass="field-editor">
                            <children>
                                <fx:include fx:id="subheaderMajorButtons" source="../../../propertyeditors/toolbar-buttons-panel.fxml" />
                                <fx:include fx:id="subheaderMinorButtons" source="../../../propertyeditors/toolbar-buttons-panel.fxml" />
                                <fx:include fx:id="footerMajorButtons" source="../../../propertyeditors/toolbar-buttons-panel.fxml" />
                                <fx:include fx:id="footerMinorButtons" source="../../../propertyeditors/toolbar-buttons-panel.fxml" />
                            </children>
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </content>
        </Tab>
    </tabs>
</TabPane>
