<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%fields" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.overviewmodel.FieldReferencesPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="fieldColumnHeaders" spacing="10.0">
      <Label maxWidth="Infinity" styleClass="field-label" text="%field" HBox.hgrow="ALWAYS" />
    </HBox>
    <VBox fx:id="fieldRows" spacing="8.0" />
    <Label fx:id="fieldsEmptyLabel" styleClass="placeholder-label" text="%no_fields_defined" />
    <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="%add_field">
        <graphic><FontIcon iconLiteral="mdi2p-plus" iconSize="16" styleClass="button-icon" /></graphic>
        <tooltip><Tooltip text="%add_field" /></tooltip>
    </Button>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
