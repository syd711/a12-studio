<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="TARGET MODEL" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.propertyeditors.TargetModelPanelController">
    <BorderPane>
        <center>
         <HBox alignment="CENTER_LEFT" spacing="6.0" BorderPane.alignment="CENTER">
            <children>
                  <ComboBox fx:id="targetModelField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                  <Button fx:id="editReferenceButton" mnemonicParsing="false" onAction="#onEditReference" styleClass="default-button">
                    <graphic>
                      <FontIcon iconLiteral="mdi2o-open-in-new" iconSize="16" />
                    </graphic>
                    <tooltip>
                      <Tooltip text="Open Document Model" />
                    </tooltip>
                  </Button>
            </children>
         </HBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
    </BorderPane>
</TitledPane>
