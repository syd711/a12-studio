<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.icons"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <IconRow label="%content_settings.collapsed_icon" path="icons.collapsedIcon" types="Expandable"/>
            <IconRow label="%content_settings.expanded_icon" path="icons.expandedIcon" types="Expandable"/>
            <ToggleRow label="%content_settings.alignment" path="icons.rightAlignment" types="Expandable" booleanValued="true" initial="true">
                <ToggleOption value="false" label="%content_settings.left"/>
                <ToggleOption value="true" label="%content_settings.right"/>
            </ToggleRow>
            <LengthRow label="%content_settings.size" path="icons.size" types="Expandable" keywords="medium,big" units="px:16" initial="medium"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
