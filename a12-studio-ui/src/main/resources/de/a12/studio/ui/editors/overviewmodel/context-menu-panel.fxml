<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="CONTEXT MENU" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.overviewmodel.ContextMenuPanelController">
 <BorderPane>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 <center>
  <VBox spacing="10.0">
    <children>
      <HBox spacing="10.0">
        <children>
          <ListView fx:id="groupsList" prefHeight="140.0" prefWidth="220.0" />
          <VBox fx:id="detailBox" spacing="8.0" HBox.hgrow="ALWAYS">
            <children>
              <VBox spacing="4.0">
                <children>
                  <Label styleClass="field-label" text="Group Name*" />
                  <TextField fx:id="groupNameField" />
                </children>
              </VBox>
              <VBox spacing="4.0">
                <children>
                  <Label styleClass="field-label" text="Label" />
                  <GridPane fx:id="groupTitleGrid" hgap="10.0" vgap="6.0">
                    <columnConstraints>
                      <ColumnConstraints minWidth="40.0" />
                      <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                  </GridPane>
                </children>
              </VBox>
              <VBox spacing="4.0">
                <children>
                  <Label styleClass="field-label" text="Actions" />
                  <GridPane fx:id="actionsGrid" hgap="8.0" vgap="6.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                      <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                      <ColumnConstraints hgrow="NEVER" minWidth="32.0" />
                    </columnConstraints>
                  </GridPane>
                  <Label fx:id="actionsEmptyLabel" styleClass="placeholder-label" text="There are no entries yet." />
                  <Button fx:id="addActionButton" mnemonicParsing="false" onAction="#onAddAction" styleClass="secondary-button" text="Add Action" />
                </children>
              </VBox>
            </children>
            <padding>
              <Insets left="10.0" />
            </padding>
          </VBox>
        </children>
      </HBox>
      <HBox spacing="8.0">
        <children>
          <Button fx:id="addGroupButton" mnemonicParsing="false" onAction="#onAddGroup" styleClass="primary-button" text="Add" />
          <Button fx:id="removeGroupButton" mnemonicParsing="false" onAction="#onRemoveGroup" styleClass="secondary-button" text="Remove Group" />
        </children>
      </HBox>
    </children>
  </VBox>
 </center>
 </BorderPane>
</TitledPane>
