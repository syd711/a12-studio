<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%related_entities" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.relationshipmodel.RelatedEntitiesPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="entityHeaders" spacing="10.0">
      <Label styleClass="field-label" text="%role" prefWidth="140.0" />
      <Label styleClass="field-label" text="%document_model" prefWidth="160.0" />
      <Label styleClass="field-label" text="%upper_limit" prefWidth="90.0" />
      <Label styleClass="field-label" text="%upper_limit_description" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      <Label styleClass="field-label" text="%orderable" prefWidth="90.0" />
      <Label styleClass="field-label" text="" prefWidth="112.0" />
    </HBox>
    <VBox fx:id="entityRows" spacing="8.0" />
    <Label fx:id="entitiesEmptyLabel" styleClass="placeholder-label" text="%no_related_entities_defined" />
    <HBox alignment="CENTER_LEFT" spacing="24.0">
        <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="%add_entity" >
                <graphic><FontIcon styleClass="button-icon" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
                <tooltip><Tooltip text="%add_entity" /></tooltip>
            </Button>
    </HBox>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
