<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%tree_node_column_mapping_panel.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeNodeColumnMappingPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="10.0">
                <!-- Left/right padding of 13 = the .module-row border (1) + padding (12), so header cells line up with the row cells.
                     Fixed widths must match TreeNodeColumnMappingPanelController.createRow(); the trailing spacer stands in for the row's actions box. -->
                <HBox fx:id="mappingHeaders" spacing="10.0">
                    <padding><Insets left="13.0" right="13.0" /></padding>
                    <Label styleClass="field-label" text="" minWidth="18.0" prefWidth="18.0" maxWidth="18.0" />
                    <Label styleClass="field-label" text="%tree_node_column_mapping_panel.column" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Label styleClass="field-label" text="%tree_node_column_mapping_panel.field" minWidth="220.0" prefWidth="220.0" maxWidth="220.0" />
                    <Label styleClass="field-label" text="%width" minWidth="70.0" prefWidth="70.0" maxWidth="70.0" />
                    <Label styleClass="field-label" text="%pin_direction" minWidth="120.0" prefWidth="120.0" maxWidth="120.0" />
                    <Region minWidth="120.0" prefWidth="120.0" maxWidth="120.0" />
                </HBox>
                <VBox fx:id="columnMappingRows" spacing="8.0" />
                <Label fx:id="noColumnsLabel" styleClass="placeholder-label" text="%no_columns_defined" />
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
