<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.appearance"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <SettingGroup types="Icon">
            <LengthRow label="%content_settings.size" path="size" keywords="medium,big" units="px:16" initial="medium"/>
            <ToggleRow label="%content_settings.variant" path="variant">
                <ToggleOption value="none" label="%content_settings.none"/>
                <ToggleOption value="info" label="%content_settings.info"/>
                <ToggleOption value="success" label="%content_settings.success"/>
                <ToggleOption value="warning" label="%content_settings.warning"/>
                <ToggleOption value="error" label="%content_settings.error"/>
            </ToggleRow>
            <TextRow label="%content_settings.title" path="title" prompt="%content_settings.enter_icon_title"/>
            </SettingGroup>
            <SettingGroup types="Expandable">
            <ToggleRow label="%content_settings.initial_status" path="initialCollapsed" booleanValued="true" initial="true">
                <ToggleOption value="true" label="%content_settings.collapsed"/>
                <ToggleOption value="false" label="%content_settings.expanded"/>
            </ToggleRow>
            </SettingGroup>
            <SettingGroup types="Tooltip">
            <ToggleRow label="%content_settings.type" path="type" initial="hint">
                <ToggleOption value="hint" label="%content_settings.hint"/>
                <ToggleOption value="error" label="%content_settings.error"/>
                <ToggleOption value="success" label="%content_settings.success"/>
                <ToggleOption value="warning" label="%content_settings.warning"/>
            </ToggleRow>
            <SwitchRow label="%content_settings.invert" path="invert"/>
            </SettingGroup>
            <SettingGroup types="InteractiveList">
            <SwitchRow label="%content_settings.divider" path="divider"/>
            <SwitchRow label="%content_settings.border" path="border"/>
            </SettingGroup>
            <SettingGroup types="InteractiveListItem">
            <SwitchRow label="%content_settings.divider" path="divider"/>
            </SettingGroup>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
