<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.fe_form_element"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <ReferenceRow label="%content_settings.fe_element" path="elementId" kind="FORM_ELEMENT" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup"/>
            <SwitchRow label="%content_settings.fe_prefix_formal_errors" path="prefixFormalErrors" types="MessageGroupDisplay"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
