<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%accessibility" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.overviewmodel.OverviewAccessibilityPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
      <left>
            <VBox spacing="4.0" BorderPane.alignment="CENTER">
                <children>
                    <Label styleClass="field-label" text="%screen_reader_column" />
                    <ComboBox fx:id="screenReaderColumnField" editable="false" maxWidth="Infinity" />
                </children>
            </VBox>
      </left>
    </BorderPane>
</TitledPane>
