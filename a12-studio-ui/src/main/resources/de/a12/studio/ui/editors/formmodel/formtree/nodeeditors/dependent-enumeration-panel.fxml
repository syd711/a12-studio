<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            text="%dependent_enumeration" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.DependentEnumerationPanelController">
    <BorderPane>
        <center>
            <VBox spacing="8.0">
                <children>
                    <VBox>
                        <children>
                            <Label styleClass="field-label" text="%dependent_enumeration_trigger_element" />
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <children>
                                    <ComboBox fx:id="masterFieldCombo" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="copyMasterFieldButton" mnemonicParsing="false" styleClass="default-button">
                                        <graphic>
                                            <FontIcon iconLiteral="mdi2c-content-copy" iconSize="16" />
                                        </graphic>
                                        <tooltip>
                                            <Tooltip text="%copy_master_field_value" />
                                        </tooltip>
                                    </Button>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                    <TableView fx:id="constraintsTable" prefHeight="420.0">
                        <columns>
                            <TableColumn fx:id="masterValueColumn" text="%dependent_enumeration_master_value_column" prefWidth="140.0" sortable="false" />
                        </columns>
                    </TableView>
                </children>
                <padding>
                    <Insets top="4.0" />
                </padding>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
