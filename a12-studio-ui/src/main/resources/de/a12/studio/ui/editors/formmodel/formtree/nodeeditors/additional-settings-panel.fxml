<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            text="%additional_settings" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.AdditionalSettingsPanelController">
    <BorderPane>
        <center>
            <VBox spacing="10.0">
                <children>
                    <VBox>
                        <children>
                            <Label styleClass="field-label" text="%initial_value" />
                            <ComboBox fx:id="initialValueCombo" maxWidth="Infinity" />
                        </children>
                    </VBox>
                    <VBox>
                        <children>
                            <Label styleClass="field-label" text="%exposition" />
                            <ComboBox fx:id="expositionCombo" maxWidth="Infinity" />
                        </children>
                    </VBox>
                    <VBox>
                        <children>
                            <Label styleClass="field-label" text="%message_position" />
                            <ComboBox fx:id="messagePositionCombo" maxWidth="Infinity" />
                        </children>
                    </VBox>
                    <CheckBox fx:id="readonlyCheckBox" text="%readonly" />
                    <VBox>
                        <children>
                            <Label styleClass="field-label" text="%readonly_presentation" />
                            <ComboBox fx:id="readonlyPresentationCombo" maxWidth="Infinity" />
                            <Label fx:id="readonlyPresentationHintLabel" styleClass="placeholder-label" wrapText="true" />
                        </children>
                    </VBox>
                    <VBox>
                        <children>
                            <Label styleClass="field-label" text="%show_asterisks" />
                            <ComboBox fx:id="markingOfRequiredFieldsCombo" maxWidth="Infinity" />
                        </children>
                    </VBox>
                </children>
            </VBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml"
                        BorderPane.alignment="CENTER" />
        </top>
    </BorderPane>
</TitledPane>
