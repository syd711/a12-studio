<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.dialogs.ModelSettingsDialog">
    <top>
        <fx:include fx:id="header" source="../../components/scene-dialog-header.fxml" />
    </top>
    <center>
      <BorderPane>
          <top>
              <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" styleClass="error-container-no-radius" BorderPane.alignment="CENTER" />
          </top>
         <center>
              <ScrollPane fitToWidth="true" styleClass="properties-panel" stylesheets="@../../stylesheet.css">
                  <content>
                      <VBox spacing="12.0" styleClass="field-editor">
                          <padding>
                              <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                          </padding>

                          <!-- Name / Version / Description -->
                          <fx:include fx:id="modelSettingsName" source="../propertyeditors/model-settings-name-panel.fxml" />

                          <!-- Form Model only: General Settings -->
                          <fx:include fx:id="generalSettings" source="../formmodel/general-settings-panel.fxml" />

                          <!-- Form Model only: General Detached Repeat Settings -->
                          <fx:include fx:id="generalDetachedRepeatSettings" source="../formmodel/general-detached-repeat-settings-panel.fxml" />

                          <!-- Form Model only: General Inline Repeat Settings -->
                          <fx:include fx:id="generalInlineRepeatSettings" source="../formmodel/general-inline-repeat-settings-panel.fxml" />

                          <!-- Form Model only: Rule Confirmation Settings -->
                          <fx:include fx:id="ruleConfirmationSettings" source="../formmodel/rule-confirmation-settings-panel.fxml" />

                          <!-- Form Model only: Subtitle -->
                          <fx:include fx:id="subtitle" source="../formmodel/subtitle-panel.fxml" />

                          <!-- Supported Characters -->
                          <fx:include fx:id="supportedCharacters" source="../propertyeditors/supported-characters-panel.fxml" />

                          <!-- Locales -->
                          <fx:include fx:id="locales" source="../propertyeditors/locales-panel.fxml" />

                          <!-- Labels -->
                          <fx:include fx:id="labels" source="../propertyeditors/localized-text-panel.fxml" />

                          <!-- Subtitles (Overview Model only) -->
                          <fx:include fx:id="subtitles" source="../propertyeditors/localized-text-panel.fxml" />

                          <!-- Roles -->
                          <fx:include fx:id="roles" source="../propertyeditors/roles-panel.fxml" />

                          <!-- Annotations -->
                          <fx:include fx:id="annotations" source="../propertyeditors/annotations-panel.fxml" />

                          <!-- Document Uniqueness Criteria -->
                          <fx:include fx:id="documentUniquenessCriteria" source="../propertyeditors/document-uniqueness-criteria-panel.fxml" />

                          <!-- Model References -->
                          <fx:include fx:id="modelReferences" source="../propertyeditors/model-references-panel.fxml" />

                          <!-- Timezone -->
                          <fx:include fx:id="timezone" source="../propertyeditors/timezone-panel.fxml" />
                      </VBox>
                  </content>
               <padding>
                  <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
               </padding>
              </ScrollPane>
         </center>
      </BorderPane>
    </center>
   <styleClass>
      <String fx:value="root" />
      <String fx:value="main" />
   </styleClass>
   <bottom>
      <ToolBar nodeOrientation="RIGHT_TO_LEFT" styleClass="footer-toolbar" BorderPane.alignment="CENTER">
        <items>
            <Button fx:id="saveBtn" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onSave" styleClass="primary-button" text="%save" />
          <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#onCancel" styleClass="secondary-button" text="%cancel" />
        </items>
        <padding>
           <Insets bottom="8.0" right="8.0" />
        </padding>
      </ToolBar>
   </bottom>
</BorderPane>
