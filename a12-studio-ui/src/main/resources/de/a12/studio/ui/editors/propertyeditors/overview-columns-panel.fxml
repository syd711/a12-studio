<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="COLUMNS" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.OverviewColumnsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="columnHeaders" spacing="10.0">
      <Label styleClass="field-label" text="" prefWidth="18.0" />
      <Label styleClass="field-label" text="Field" prefWidth="200.0" />
      <Label styleClass="field-label" text="Sortable" prefWidth="70.0" />
      <Label styleClass="field-label" text="Width" prefWidth="70.0" />
      <Label styleClass="field-label" text="Pin Direction" prefWidth="100.0" />
    </HBox>
    <VBox fx:id="columnRows" spacing="8.0" />
    <Label fx:id="columnsEmptyLabel" styleClass="placeholder-label" text="No columns defined." />
    <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="Add" />
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
