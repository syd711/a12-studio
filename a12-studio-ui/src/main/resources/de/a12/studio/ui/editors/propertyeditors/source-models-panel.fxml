<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="SOURCE MODELS" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.SourceModelsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="sourceModelHeaders" spacing="10.0">
      <Label styleClass="field-label" text="" prefWidth="18.0" />
      <Label styleClass="field-label" text="Name" prefWidth="150.0" />
      <Label styleClass="field-label" text="Model" prefWidth="200.0" />
      <Label styleClass="field-label" text="Repetitions" prefWidth="100.0" />
      <Label styleClass="field-label" text="Skip Document Validation" prefWidth="150.0" />
    </HBox>
    <VBox fx:id="sourceModelRows" spacing="8.0" />
    <Label fx:id="sourceModelsEmptyLabel" styleClass="placeholder-label" text="No source models defined." />
    <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="Add" />
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
