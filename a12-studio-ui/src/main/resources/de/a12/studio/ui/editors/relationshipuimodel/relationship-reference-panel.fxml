<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%relationship_reference" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.relationshipuimodel.RelationshipReferencePanelController">
    <BorderPane>
        <center>
         <HBox spacing="24.0">
            <children>
               <VBox spacing="6.0">
                  <children>
                          <Label styleClass="field-label" text="%relationship_reference" />
                          <ComboBox fx:id="relationshipField" editable="false" />
                  </children>
               </VBox>
                  <VBox spacing="6.0">
                      <children>
                          <Label styleClass="field-label" text="%target_role" />
                          <ComboBox fx:id="targetRoleField" editable="false" />
                      </children>
                  </VBox>
            </children>
         </HBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
    </BorderPane>
</TitledPane>
