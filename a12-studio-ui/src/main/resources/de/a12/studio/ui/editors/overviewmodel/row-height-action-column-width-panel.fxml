<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane resources="messages" fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%row_height_and_action_column_width" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.overviewmodel.RowHeightActionColumnWidthPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <HBox spacing="24.0">
                <children>
                    <VBox maxWidth="200.0" spacing="4.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <children>
                                    <Label styleClass="field-label" text="%row_height" />
                                    <Label>
                                        <graphic>
                                            <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                                        </graphic>
                                        <tooltip>
                                            <Tooltip prefWidth="300.0"
                                                     text="%specify_a_fixed_height_for_the_rows_row_height_should_be_lar"
                                                     wrapText="true" />
                                        </tooltip>
                                    </Label>
                                </children>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <children>
                                    <Spinner fx:id="rowHeightField" editable="true" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                                    <Label text="%px" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                    <VBox maxWidth="200.0" spacing="4.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <children>
                                    <Label styleClass="field-label" text="%action_column_width" />
                                    <Label>
                                        <graphic>
                                            <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                                        </graphic>
                                        <tooltip>
                                            <Tooltip prefWidth="300.0"
                                                     text="%specify_the_max_width_of_the_action_column_when_all_buttons_"
                                                     wrapText="true" />
                                        </tooltip>
                                    </Label>
                                </children>
                            </HBox>
                            <TextField fx:id="actionColumnWidthField" maxWidth="Infinity" />
                        </children>
                    </VBox>
                </children>
            </HBox>
        </center>
    </BorderPane>
</TitledPane>
