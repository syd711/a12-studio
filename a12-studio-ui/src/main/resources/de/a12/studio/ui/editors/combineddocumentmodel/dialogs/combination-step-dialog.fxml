<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" maxHeight="Infinity" maxWidth="Infinity" minHeight="360.0" minWidth="480.0" styleClass="navigation-panel" stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.combineddocumentmodel.dialogs.CombinationStepDialogController">
   <top>
      <fx:include fx:id="header" source="/de/a12/studio/ui/components/scene-dialog-header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll-pane" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="14.0">
               <children>
                  <VBox spacing="6.0">
                     <children>
                        <Label styleClass="field-label" text="%type" />
                        <ComboBox fx:id="typeField" editable="false" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox fx:id="additiveModelBox" spacing="6.0">
                     <children>
                        <Label styleClass="field-label" text="%model_for_addition" />
                        <ComboBox fx:id="additiveModelField" editable="false" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox fx:id="selectionModelBox" spacing="6.0">
                     <children>
                        <Label styleClass="field-label" text="%model_for_selection" />
                        <ComboBox fx:id="selectionModelField" editable="false" maxWidth="Infinity" />
                     </children>
                  </VBox>
                  <VBox fx:id="decorationModelBox" spacing="6.0">
                     <children>
                        <Label styleClass="field-label" text="%model_for_decoration" />
                        <ComboBox fx:id="decorationModelField" editable="false" maxWidth="Infinity" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" styleClass="footer-toolbar" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onDialogCancel" styleClass="secondary-button" text="%cancel">
               <HBox.margin>
                  <Insets right="12.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false" onAction="#onDialogSubmit" styleClass="primary-button" text="%ok" />
         </children>
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
