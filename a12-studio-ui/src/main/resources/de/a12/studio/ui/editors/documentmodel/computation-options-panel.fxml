<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%computation_options" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.documentmodel.ComputationOptionsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="8.0">
    <children>
      <CheckBox fx:id="allowDifferingDecimalPlacesCheckBox" text="%allow_differing_decimal_places" />
      <CheckBox fx:id="commonPreconditionCheckBox" text="%common_precondition" />
      <TextArea fx:id="commonPreconditionTextArea" prefRowCount="4" visible="false" managed="false" wrapText="true" />
    </children>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
