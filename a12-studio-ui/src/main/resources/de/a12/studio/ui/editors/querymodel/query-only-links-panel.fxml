<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%query_only_links.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.querymodel.QueryOnlyLinksPanelController">
  <BorderPane>
    <top>
      <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
    </top>
    <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
        <padding>
          <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
        </padding>
        <CheckBox fx:id="onlyLinksCheckBox" mnemonicParsing="false" text="%query_only_links.checkbox">
          <tooltip>
            <Tooltip prefWidth="320.0" text="%query_only_links.checkbox_hint" wrapText="true" />
          </tooltip>
        </CheckBox>
      </VBox>
    </center>
  </BorderPane>
</TitledPane>
