<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" maxHeight="Infinity" maxWidth="Infinity" minHeight="-Infinity" minWidth="520.0"
            prefHeight="560.0" styleClass="navigation-panel" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.documentmodel.dialogs.MoveGroupDialogController">
    <top>
        <fx:include fx:id="header" source="/de/a12/studio/ui/components/scene-dialog-header.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="dialog-scroll-pane" BorderPane.alignment="TOP_LEFT">
            <content>
                <VBox spacing="0.0">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>

                    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" />

                    <!-- Mode selection -->
                    <Label styleClass="field-label" text="%move_group_dialog.target_document_model" />

                    <VBox spacing="8.0">
                        <VBox.margin><Insets top="8.0" /></VBox.margin>
                        <RadioButton fx:id="existingModelRadio" text="%move_group_dialog.use_existing_model">
                            <toggleGroup><ToggleGroup fx:id="modeGroup" /></toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="newModelRadio" text="%move_group_dialog.create_new_model" toggleGroup="$modeGroup" />
                    </VBox>

                    <Separator>
                        <VBox.margin><Insets top="14.0" bottom="14.0" /></VBox.margin>
                    </Separator>

                    <!-- Existing model section -->
                    <VBox fx:id="existingModelSection" spacing="0.0">
                        <Label styleClass="field-label" text="%document_model" />
                        <ComboBox fx:id="existingModelCombo" maxWidth="1.7976931348623157E308"
                                  promptText="%move_group_dialog.select_document_model">
                            <VBox.margin><Insets top="4.0" /></VBox.margin>
                        </ComboBox>
                    </VBox>

                    <!-- New model section -->
                    <VBox fx:id="newModelSection" spacing="0.0" managed="false" visible="false">
                        <fx:include fx:id="newDocumentModelPanel"
                                    source="/de/a12/studio/ui/components/new-document-model-panel.fxml" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <ToolBar nodeOrientation="RIGHT_TO_LEFT" prefHeight="40.0" styleClass="footer-toolbar"
                 BorderPane.alignment="CENTER">
            <items>
                <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false"
                        onAction="#onDialogSubmit" styleClass="primary-button"
                        text="%move_group_dialog.move_button" />
                <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false"
                        onAction="#onDialogCancel" styleClass="secondary-button" text="%cancel" />
            </items>
        </ToolBar>
    </bottom>
</BorderPane>
