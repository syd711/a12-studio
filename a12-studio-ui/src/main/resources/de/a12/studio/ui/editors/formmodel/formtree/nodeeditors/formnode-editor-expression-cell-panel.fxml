<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            styleClass="properties-panel" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.FormNodeEditorExpressionCellPanelController">
    <content>
        <TitledPane fx:id="root" expanded="true" maxWidth="Infinity" text="%expression_cell">
            <BorderPane>
                <center>
                    <VBox spacing="10.0" styleClass="field-editor">
                        <children>
                            <VBox>
                                <children>
                                    <Label styleClass="field-label" text="%name" />
                                    <TextField fx:id="nameField" />
                                </children>
                            </VBox>
                            <VBox>
                                <children>
                                    <Label styleClass="field-label" text="%expression_cell_expression" />
                                    <TextArea fx:id="expressionArea" prefRowCount="4" wrapText="true" />
                                </children>
                            </VBox>
                        </children>
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                    </VBox>
                </center>
                <top>
                    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml"
                                BorderPane.alignment="CENTER" />
                </top>
            </BorderPane>
        </TitledPane>
    </content>
</ScrollPane>
