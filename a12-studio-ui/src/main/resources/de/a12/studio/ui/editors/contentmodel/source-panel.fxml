<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.source"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <TextRow label="%content_settings.static_url" path="src.static" types="Image" secureUrl="true" prompt="%content_settings.enter_url"/>
            <TextRow label="%content_settings.field_reference" path="src.dynamic" types="Image" prompt="%content_settings.group_id_of_an_attachment_field"/>
            <TextRow label="%content_settings.url" path="src" types="Video" secureUrl="true" prompt="%content_settings.https_example_com"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
