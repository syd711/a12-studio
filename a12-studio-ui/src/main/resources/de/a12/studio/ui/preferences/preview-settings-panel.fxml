<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.preferences.PreviewSettingsPanelController">
    <top>
        <VBox BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label styleClass="preference-title" text="A12 STUDIO SETTINGS" />
                <Label styleClass="preference-subtitle" text="Preview Settings" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" left="12.0" top="12.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="6.0" BorderPane.alignment="TOP_LEFT">
            <children>
                <Label styleClass="field-label" text="Browser" />
                <ComboBox fx:id="browserTypeCombo" prefWidth="200.0" />

                <VBox spacing="6.0">
                    <children>
                        <CheckBox fx:id="autoRefreshCheckBox" text="Automatically refresh the preview" />
                        <Label styleClass="field-label" text="Refresh Delay (ms)" />
                        <TextField fx:id="autoRefreshDelayField" prefWidth="120.0" />
                    </children>
                    <VBox.margin>
                        <Insets top="12.0" />
                    </VBox.margin>
                </VBox>
            </children>
            <padding>
                <Insets left="12.0" right="12.0" top="8.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
