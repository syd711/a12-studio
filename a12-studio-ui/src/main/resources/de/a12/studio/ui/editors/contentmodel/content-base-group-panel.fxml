<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_base_group_panel.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentBaseGroupPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <HBox alignment="CENTER_LEFT" spacing="6.0" BorderPane.alignment="CENTER">
                <children>
                    <ComboBox fx:id="baseGroupField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    <Button fx:id="clearBaseGroupButton" mnemonicParsing="false" onAction="#onClearBaseGroup" styleClass="default-button">
                        <graphic>
                            <FontIcon iconLiteral="mdi2c-close" iconSize="16" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="%content_base_group_panel.clear" />
                        </tooltip>
                    </Button>
                    <Label fx:id="infoIcon" />
                </children>
            </HBox>
        </center>
    </BorderPane>
</TitledPane>
