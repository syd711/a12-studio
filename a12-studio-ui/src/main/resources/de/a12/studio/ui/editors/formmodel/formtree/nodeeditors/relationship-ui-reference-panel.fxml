<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%relationship_ui_model_reference" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.RelationshipUiReferencePanelController">
    <BorderPane>
        <center>
         <HBox alignment="CENTER_LEFT" spacing="6.0" BorderPane.alignment="CENTER">
            <children>
                  <ComboBox fx:id="referenceField" editable="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                  <Button fx:id="openReferenceButton" mnemonicParsing="false" onAction="#onOpenReference" styleClass="default-button">
                    <graphic>
                      <FontIcon iconLiteral="mdi2p-pencil-outline" iconSize="16" />
                    </graphic>
                    <tooltip>
                      <Tooltip text="%open_relationship_ui_model" />
                    </tooltip>
                  </Button>
            </children>
         </HBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
    </BorderPane>
</TitledPane>
