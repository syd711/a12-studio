<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.querymodel.PostProcessingPanelController">
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="properties-panel" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="20.0" styleClass="field-editor">
                    <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                    </padding>
                    <children>
                        <!-- Sorting -->
                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="section-header" text="%sorting" />
                                <HBox fx:id="sortingHeaderRow" spacing="10.0">
                                    <children>
                                        <Label styleClass="field-label" prefWidth="18.0" text="" />
                                        <Label styleClass="field-label" prefWidth="220.0" text="%relationship_traversal" />
                                        <Label styleClass="field-label" prefWidth="200.0" text="%field" />
                                        <Label styleClass="field-label" prefWidth="110.0" text="%direction" />
                                        <Label styleClass="field-label" prefWidth="90.0" text="%ignore_case" />
                                        <Label styleClass="field-label" prefWidth="140.0" text="%null_handling" />
                                    </children>
                                </HBox>
                                <VBox fx:id="sortingRows" spacing="8.0" />
                                <Label fx:id="sortingEmptyLabel" styleClass="placeholder-label" text="%no_sorting_defined" />
                                <Button mnemonicParsing="false" onAction="#onAddSort" styleClass="primary-button" text="%add_sort_entry">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2p-plus" iconSize="16" styleClass="button-icon" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="%add_sort_entry" />
                                    </tooltip>
                                </Button>
                            </children>
                        </VBox>

                        <!-- Paging -->
                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="section-header" text="%paging" />
                                <HBox spacing="24.0">
                                    <children>
                                        <VBox maxWidth="200.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="field-label" text="%page_number" />
                                                <Spinner fx:id="pageNumberField" editable="true" maxWidth="Infinity" />
                                            </children>
                                        </VBox>
                                        <VBox maxWidth="200.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="field-label" text="%page_size" />
                                                <Spinner fx:id="pageSizeField" editable="true" maxWidth="Infinity" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Aggregation -->
                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="section-header" text="%aggregation" />
                                <CheckBox fx:id="aggregateResultsField" mnemonicParsing="false" text="%aggregate_results" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
