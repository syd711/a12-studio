<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.queries"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.MediaQueryPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="6.0">
                <children>
                    <ToggleRow fx:id="operatorRow" label="%content_settings.operator" path="operator" types="MediaQuery" initial="or">
                        <ToggleOption value="or" label="%content_settings.operator_or" />
                        <ToggleOption value="and" label="%content_settings.operator_and" />
                    </ToggleRow>
                    <VBox fx:id="queriesBox" spacing="6.0" />
                    <Button fx:id="addQueryButton" text="%content_settings.query_add" />
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
