<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%model_config" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.ModelConfigPanelController">
 <BorderPane>
 <center>
  <GridPane hgap="10.0" vgap="8.0">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
      <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
    </columnConstraints>

    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
      <Label styleClass="field-label" text="%decimal_separator" />
      <ComboBox fx:id="decimalSeparatorCombo" editable="false" maxWidth="Infinity" />
    </VBox>
    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
      <Label styleClass="field-label" text="%condition_language" />
      <ComboBox fx:id="conditionLanguageCombo" maxWidth="Infinity" />
    </VBox>
  </GridPane>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
