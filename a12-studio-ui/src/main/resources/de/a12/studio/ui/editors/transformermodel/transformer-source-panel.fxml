<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css, @transformer-model.css" text="%transformer_model.source.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.transformermodel.TransformerSourcePanelController">
  <BorderPane>
    <top>
      <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER"/>
    </top>
    <center>
      <VBox fx:id="fields" spacing="12.0">
        <padding>
          <Insets bottom="4.0" left="4.0" right="4.0" top="4.0"/>
        </padding>
      </VBox>
    </center>
  </BorderPane>
</TitledPane>
