<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component, sidebar-panel" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.projecttree.ProjectTreeController">
    <center>
        <TreeView fx:id="projectTree" prefHeight="200.0" prefWidth="200.0" />
    </center>
    <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
              <ToolBar prefHeight="40.0" prefWidth="200.0">
                  <items>
                      <MenuButton fx:id="newButton" accessibleText="New" mnemonicParsing="false" styleClass="default-button">
                          <graphic>
                              <FontIcon iconLiteral="mdi2f-file-document-plus-outline" iconSize="18" styleClass="toolbar-icon" />
                          </graphic>
                          <tooltip>
                              <Tooltip text="New" />
                          </tooltip>
                      </MenuButton>
                      <Separator orientation="VERTICAL" />
                      <Button accessibleText="Reload project tree" mnemonicParsing="false" onAction="#onReload" styleClass="default-button">
                          <graphic>
                              <FontIcon iconLiteral="mdi2r-refresh" iconSize="18" styleClass="toolbar-icon" />
                          </graphic>
                          <tooltip>
                              <Tooltip text="Reload project tree" />
                          </tooltip>
                      </Button>
                      <Separator orientation="VERTICAL" />
                      <Button accessibleText="Expand all" mnemonicParsing="false" onAction="#onExpandAll" styleClass="default-button">
                          <graphic>
                              <FontIcon iconLiteral="mdi2a-arrow-expand-vertical" iconSize="18" styleClass="toolbar-icon" />
                          </graphic>
                          <tooltip>
                              <Tooltip text="Expand all" />
                          </tooltip>
                      </Button>
                      <Button accessibleText="Collapse all" mnemonicParsing="false" onAction="#onCollapseAll" styleClass="default-button">
                          <graphic>
                              <FontIcon iconLiteral="mdi2a-arrow-collapse-vertical" iconSize="18" styleClass="toolbar-icon" />
                          </graphic>
                          <tooltip>
                              <Tooltip text="Collapse all" />
                          </tooltip>
                      </Button>
                      <Separator orientation="VERTICAL" />
                      <fx:include fx:id="search" source="../components/search-field.fxml" />
                  </items>
              </ToolBar>
         </children>
      </VBox>
    </top>
</BorderPane>
