<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            text="%label" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.RepeatLabelPanelController">
    <BorderPane>
        <center>
            <VBox spacing="8.0">
                <fx:include fx:id="groupConfigLabel" source="../../../propertyeditors/localized-text-type-panel.fxml"
                            styleClass="titled-pane-sub-child" />
                <fx:include fx:id="repeatLabel" source="../../../propertyeditors/localized-text-type-panel.fxml"
                            styleClass="titled-pane-sub-child" />
            </VBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml"
                        BorderPane.alignment="CENTER" />
        </top>
    </BorderPane>
</TitledPane>
