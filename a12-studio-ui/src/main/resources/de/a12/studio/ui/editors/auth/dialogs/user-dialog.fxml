<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="420.0" styleClass="navigation-panel" stylesheets="@../../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.auth.dialogs.UserDialogController">
   <top>
      <fx:include fx:id="header" source="../../../components/scene-dialog-header.fxml" />
   </top>
   <center>
      <VBox spacing="8.0" BorderPane.alignment="TOP_LEFT">
         <children>
            <Label styleClass="field-label" text="Username" />
            <TextField fx:id="usernameField" promptText="Enter the username here..." />
            <Label styleClass="field-label" text="Password" />
            <TextField fx:id="passwordField" promptText="Enter the password here..." />
            <Label styleClass="field-label" text="Authorities" />
            <TextField fx:id="authoritiesField" promptText="Comma-separated authorities..." />
            <Label styleClass="field-label" text="Email" />
            <TextField fx:id="emailField" promptText="Enter the email address here..." />
            <Label styleClass="field-label" text="First Name" />
            <TextField fx:id="firstnameField" promptText="Enter the first name here..." />
            <Label styleClass="field-label" text="Last Name" />
            <TextField fx:id="lastnameField" promptText="Enter the last name here..." />
         </children>
         <BorderPane.margin>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <bottom>
      <ToolBar nodeOrientation="RIGHT_TO_LEFT" prefHeight="40.0" prefWidth="200.0" styleClass="footer-toolbar" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false" onAction="#onDialogSubmit" styleClass="primary-button" text="OK" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onDialogCancel" styleClass="secondary-button" text="Cancel" />
         </items>
      </ToolBar>
   </bottom>
</BorderPane>
