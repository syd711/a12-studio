<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%priority" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.PriorityPanelController">
 <BorderPane>
 <center>
  <HBox spacing="12.0">
    <children>
      <VBox spacing="2.0" HBox.hgrow="ALWAYS">
        <children>
          <ComboBox fx:id="priorityField" maxWidth="Infinity" />
        </children>
      </VBox>
      <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
        <children>
          <CheckBox fx:id="destructiveField" mnemonicParsing="false" text="%destructive" />
        </children>
      </VBox>
    </children>
  </HBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
