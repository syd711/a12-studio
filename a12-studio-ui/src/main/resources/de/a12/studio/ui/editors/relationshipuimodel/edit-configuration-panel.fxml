<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%edit_dialog"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.relationshipuimodel.EditConfigurationPanelController">
    <BorderPane>
        <center>
            <VBox spacing="14.0">
                <children>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%available_items_overview_model"/>
                            <ComboBox fx:id="availableItemsField" editable="false" maxWidth="Infinity"/>
                        </children>
                    </VBox>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%selected_items_overview_model"/>
                            <ComboBox fx:id="selectedItemsField" editable="false" maxWidth="Infinity"/>
                        </children>
                    </VBox>
                    <fx:include fx:id="dialogTitle" source="../propertyeditors/localized-text-panel.fxml" styleClass="titled-pane-sub-child"/>
                    <GridPane hgap="14.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.34"/>
                        </columnConstraints>
                        <children>
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="field-label" text="%dialog_width"/>
                                    <TextField fx:id="dialogWidthField"/>
                                </children>
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="field-label" text="%dialog_max_width"/>
                                    <TextField fx:id="dialogMaxWidthField"/>
                                </children>
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="field-label" text="%dialog_max_height"/>
                                    <TextField fx:id="dialogMaxHeightField"/>
                                </children>
                            </VBox>
                        </children>
                    </GridPane>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%height"/>
                            <TextField fx:id="heightField"/>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml"
                        BorderPane.alignment="CENTER"/>
        </top>
    </BorderPane>
</TitledPane>
