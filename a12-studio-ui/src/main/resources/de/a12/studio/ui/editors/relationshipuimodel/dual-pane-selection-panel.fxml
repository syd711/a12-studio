<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%dual_pane_selection"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.relationshipuimodel.DualPaneSelectionPanelController">
    <BorderPane>
        <center>
            <VBox spacing="14.0">
                <children>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%available_items_overview_model"/>
                            <ComboBox fx:id="availableItemsField" editable="false" />
                        </children>
                    </VBox>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%selected_items_overview_model"/>
                            <ComboBox fx:id="selectedItemsField" editable="false" />
                        </children>
                    </VBox>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%link_form_model"/>
                            <ComboBox fx:id="linkFormModelField" editable="false" />
                        </children>
                    </VBox>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%height"/>
                            <TextField fx:id="heightField"/>
                        </children>
                    </VBox>
                    <fx:include fx:id="buttons" source="../propertyeditors/event-buttons-panel.fxml" styleClass="titled-pane-sub-child"/>
                </children>
            </VBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml"
                        BorderPane.alignment="CENTER"/>
        </top>
    </BorderPane>
</TitledPane>
