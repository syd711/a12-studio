<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            text="%control_index" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.ControlIndexPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="6.0">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%control_index_type" />
                            <Label fx:id="infoIcon" />
                        </children>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <children>
                            <ComboBox fx:id="typeField" editable="false" maxWidth="Infinity" promptText="%control_index_type_prompt" HBox.hgrow="ALWAYS" />
                            <Button fx:id="clearButton" mnemonicParsing="false" onAction="#onClear" styleClass="default-button">
                                <graphic>
                                    <FontIcon iconLiteral="mdi2c-close" iconSize="16" />
                                </graphic>
                                <tooltip>
                                    <Tooltip text="%control_index_clear" />
                                </tooltip>
                            </Button>
                        </children>
                    </HBox>
                    <Label styleClass="field-label" text="%control_index_value" />
                    <TextField fx:id="valueField" />
                </children>
                <padding>
                    <Insets bottom="4.0" top="4.0" />
                </padding>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
