<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%event_buttons" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.EventButtonsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="buttonsHeader" spacing="10.0">
      <padding>
        <Insets left="12.0" right="12.0" />
      </padding>
      <Label styleClass="field-label" text="" prefWidth="18.0" />
      <Label styleClass="field-label" text="%event" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      <Label styleClass="field-label" text="%priority" prefWidth="140.0" />
      <Label styleClass="field-label" text="%destructive" prefWidth="110.0" />
      <Label styleClass="field-label" text="%icon" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      <!-- Placeholder matching the move-up/move-down + delete actions box width (2 * 34px buttons + 4px spacing) at the end of each row. -->
      <Label styleClass="field-label" text="" prefWidth="72.0" />
    </HBox>
    <VBox fx:id="buttonsList" spacing="8.0" />
    <Label fx:id="emptyLabel" styleClass="placeholder-label" text="%there_are_no_entries_yet" />
    <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="%add_event_button" >
                <graphic><FontIcon styleClass="button-icon" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
                <tooltip><Tooltip text="%add_event_button" /></tooltip>
            </Button>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
