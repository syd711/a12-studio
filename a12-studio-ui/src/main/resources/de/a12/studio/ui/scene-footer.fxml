<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:id="footer" maxHeight="18.0" minHeight="18.0" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.FooterController">

    <padding>
        <Insets bottom="4.0" />
    </padding>

    <left>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="footer-file-info" BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label fx:id="filePathLabel" styleClass="footer-label" />
                <Label fx:id="fileSizeLabel" styleClass="footer-label" />
                <Label fx:id="fileModifiedLabel" styleClass="footer-label" />
                <Label fx:id="fileEncodingLabel" styleClass="footer-label" />
            </children>
        </HBox>
    </left>
</BorderPane>
