<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane resources="@/messages" fx:id="footer" maxHeight="20.0" minHeight="20.0" styleClass="footer-bar" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.FooterController">

    <padding>
        <Insets bottom="8.0" right="8.0" top="3.0" />
    </padding>

    <left>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="footer-file-info" BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label fx:id="filePathLabel" styleClass="footer-label" />
            <Separator layoutX="76.0" layoutY="10.0" orientation="VERTICAL" prefHeight="200.0" />
                <Label fx:id="fileSizeLabel" styleClass="footer-label" />
            <Separator layoutX="28.0" layoutY="10.0" orientation="VERTICAL" prefHeight="200.0" />
                <Label fx:id="fileModifiedLabel" styleClass="footer-label" />
            <Separator orientation="VERTICAL" prefHeight="200.0" />
                <Label fx:id="fileEncodingLabel" styleClass="footer-label" />
            <Separator layoutX="49.0" layoutY="10.0" orientation="VERTICAL" prefHeight="200.0" />
            </children>
        </HBox>
    </left>
   <right>
      <HBox fx:id="previewAppStatus" alignment="CENTER_RIGHT" spacing="6.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets right="6.0" />
         </padding>
         <children>
            <Label fx:id="previewAppStatusLabel" styleClass="footer-label" />
            <Button fx:id="previewAppStatusBtn" accessibleText="%preview_app_log" mnemonicParsing="false" onAction="#onOpenPreviewAppLog" styleClass="footer-icon-button">
               <graphic>
                  <FontIcon fx:id="previewAppStatusIcon" iconLiteral="mdi2r-record" iconSize="18" styleClass="preview-app-status-icon" />
               </graphic>
               <tooltip>
                  <Tooltip text="%preview_app_log" />
               </tooltip>
            </Button>
         </children>
      </HBox>
   </right>
</BorderPane>
