<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="footer" maxHeight="20.0" minHeight="20.0" styleClass="footer-bar" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.FooterController">

    <padding>
        <Insets bottom="8.0" right="8.0" top="3.0" />
    </padding>

    <left>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="footer-file-info" BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label fx:id="filePathLabel" styleClass="footer-label" />
            <Separator layoutX="76.0" layoutY="10.0" orientation="VERTICAL" prefHeight="200.0" />
                <Label fx:id="fileSizeLabel" styleClass="footer-label" />
            <Separator layoutX="28.0" layoutY="10.0" orientation="VERTICAL" prefHeight="200.0" />
                <Label fx:id="fileModifiedLabel" styleClass="footer-label" />
            <Separator orientation="VERTICAL" prefHeight="200.0" />
                <Label fx:id="fileEncodingLabel" styleClass="footer-label" />
            <Separator layoutX="49.0" layoutY="10.0" orientation="VERTICAL" prefHeight="200.0" />
            </children>
        </HBox>
    </left>
   <right>
      <HBox fx:id="previewAppStatus" alignment="CENTER_RIGHT" spacing="6.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets right="6.0" />
         </padding>
         <children>
            <Label fx:id="previewAppStatusLabel" styleClass="footer-label" />
            <StackPane>
               <children>
                  <FontIcon iconLiteral="mdi2s-server" iconSize="14" styleClass="footer-preview-app-icon" />
                  <Circle fx:id="previewAppStatusBubble" mouseTransparent="true" radius="4" styleClass="preview-app-status-bubble" translateX="7" translateY="7" StackPane.alignment="CENTER" />
               </children>
            </StackPane>
         </children>
      </HBox>
   </right>
</BorderPane>
