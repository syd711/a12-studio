<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" text="HELPER TEXT" maxWidth="Infinity" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.propertyeditors.HelperTextPanelController">
 <BorderPane>
 <center>
  <VBox>
    <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <TableView fx:id="helperTextTable" editable="true" prefHeight="120.0">
      <columns>
        <TableColumn fx:id="helperTextLocaleColumn" text="LOCALE" prefWidth="80.0" />
        <TableColumn fx:id="helperTextTextColumn" text="TEXT" />
      </columns>
    </TableView>
  </VBox>
 </center>
 <top>
    <VBox fx:id="errorContainer" styleClass="error-container" BorderPane.alignment="CENTER">
       <children>
          <Label fx:id="errorTitle" styleClass="error-title" />
          <Label fx:id="errorMessage" styleClass="error-message" />
       </children>
    </VBox>
 </top>
 </BorderPane>
</TitledPane>
