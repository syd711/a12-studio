<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.preferences.AdvancedSettingsPanelController">
    <top>
        <VBox BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label styleClass="preference-title" text="PROJECT SETTINGS" />
                <Label styleClass="preference-subtitle" text="Advanced Settings" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" left="12.0" top="12.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="3.0" BorderPane.alignment="TOP_LEFT">
            <children>
            <VBox spacing="3.0">
               <children>
                      <CheckBox fx:id="useApplicationGroupsCheckBox" text="Use Application Groups" />
                      <Label styleClass="field-description" wrapText="true" text="Prefixes every model's id with the group name and updates all references, so this project's models stay unique when deployed alongside other A12 applications." />
               </children>
            </VBox>
            <VBox>
               <children>
      
                      <Label styleClass="field-label" text="Application Group Name:" />
                      <TextField fx:id="applicationGroupNameField" prefWidth="280.0" promptText="Enter the application group name here..." />
               </children>
               <VBox.margin>
                  <Insets left="22.0" top="12.0" />
               </VBox.margin>
            </VBox>
            <VBox alignment="CENTER_RIGHT">
               <children>
                  <Button fx:id="applyBtn" mnemonicParsing="false" onAction="#onApplicationGroupApply" styleClass="primary-button" text="Apply Application Group" >
                <tooltip><Tooltip text="Apply application group name" /></tooltip>
            </Button>
               </children>
            </VBox>
            </children>
            <padding>
                <Insets left="12.0" right="12.0" top="8.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
