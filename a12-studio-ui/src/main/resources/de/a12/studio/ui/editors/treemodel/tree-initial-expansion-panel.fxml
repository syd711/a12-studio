<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%tree_initial_expansion_panel.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeInitialExpansionPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="12.0">
                <CheckBox fx:id="enableField" mnemonicParsing="false" text="%tree_initial_expansion_panel.enable" />
                <VBox fx:id="detailsBox" spacing="12.0">
                    <VBox maxWidth="360.0" spacing="4.0">
                        <Label styleClass="field-label" text="%tree_initial_expansion_panel.type" />
                        <ComboBox fx:id="typeField" editable="false" maxWidth="Infinity" />
                    </VBox>
                    <VBox fx:id="levelsBox" maxWidth="200.0" spacing="4.0">
                        <Label styleClass="field-label" text="%tree_initial_expansion_panel.levels" />
                        <Spinner fx:id="levelsField" editable="true" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="8.0">
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label styleClass="field-label" text="%tree_initial_expansion_panel.node_types" />
                            <Label fx:id="nodeTypesInfoIcon" />
                        </HBox>
                        <VBox fx:id="nodeRefRows" spacing="8.0" />
                        <Label fx:id="noNodeTypesLabel" styleClass="placeholder-label" text="%tree_initial_expansion_panel.no_node_types" />
                        <HBox spacing="8.0">
                            <Button fx:id="addNodeTypeButton" mnemonicParsing="false" onAction="#onAddNodeType" styleClass="primary-button" text="%tree_initial_expansion_panel.add_node_type">
                                <graphic><FontIcon styleClass="button-icon" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
                                <tooltip><Tooltip text="%tree_initial_expansion_panel.add_node_type" /></tooltip>
                            </Button>
                        </HBox>
                    </VBox>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
