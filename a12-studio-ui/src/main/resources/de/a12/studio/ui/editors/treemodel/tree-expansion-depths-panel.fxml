<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%tree_expansion_depths_panel.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeExpansionDepthsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <!-- Left/right padding of 13 = the .module-row border (1) + padding (12), so header cells line up with the row cells.
         Fixed widths must match TreeExpansionDepthsPanelController.createRow(); the trailing spacer stands in for the row's actions box. -->
    <HBox fx:id="depthHeaders" spacing="10.0">
      <padding><Insets left="13.0" right="13.0" /></padding>
      <Label styleClass="field-label" text="%tree_expansion_depths_panel.relationship" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      <HBox alignment="CENTER_LEFT" spacing="6.0" minWidth="120.0" prefWidth="120.0" maxWidth="120.0">
        <Label styleClass="field-label" text="%tree_expansion_depths_panel.max_depth" />
        <Label>
          <graphic><FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" /></graphic>
          <tooltip><Tooltip prefWidth="300.0" text="%tree_expansion_depths_panel.max_depth_info" wrapText="true" /></tooltip>
        </Label>
      </HBox>
      <Region minWidth="80.0" prefWidth="80.0" maxWidth="80.0" />
    </HBox>
    <VBox fx:id="depthRows" spacing="8.0" />
    <Label fx:id="depthsEmptyLabel" styleClass="placeholder-label" text="%tree_expansion_depths_panel.none_defined" />
    <HBox spacing="8.0">
      <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="%tree_expansion_depths_panel.add">
        <graphic><FontIcon styleClass="button-icon" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
        <tooltip><Tooltip text="%tree_expansion_depths_panel.add" /></tooltip>
      </Button>
    </HBox>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
