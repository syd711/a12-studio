<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane resources="messages" fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%document_uniqueness_criteria" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.DocumentUniquenessCriteriaPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <HBox fx:id="criteriaColumnHeaders" spacing="10.0">
      <Label styleClass="field-label" text="%name" prefWidth="160.0" />
      <Label styleClass="field-label" text="%fields" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
    </HBox>
    <VBox fx:id="criteriaRows" spacing="8.0" />
    <Label fx:id="criteriaEmptyLabel" styleClass="placeholder-label" text="%no_uniqueness_criteria_defined" />
    <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="%add" >
                <tooltip><Tooltip text="%add_uniqueness_criterion" /></tooltip>
            </Button>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
