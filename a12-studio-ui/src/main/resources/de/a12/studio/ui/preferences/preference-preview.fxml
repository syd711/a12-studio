<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.preferences.PreferencePreviewController">
    <top>
        <VBox BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label styleClass="preference-title" text="%project_settings" />
                <Label styleClass="preference-subtitle" text="%preview_settings" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" left="12.0" top="12.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="6.0" BorderPane.alignment="TOP_LEFT">
            <children>
                <Label styleClass="field-label" text="%preview_app_url" />
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <TextField fx:id="urlField" prefWidth="280.0" />
                        <Button fx:id="testConnectionButton" mnemonicParsing="false" onAction="#onTestConnection" text="%test_connection" />
                    </children>
                </HBox>

                <VBox spacing="6.0">
                    <children>
                        <Label styleClass="field-label" text="%username" />
                        <TextField fx:id="usernameField" prefWidth="200.0" />
                        <Label styleClass="field-label" text="%password" />
                        <PasswordField fx:id="passwordField" prefWidth="200.0" />
                    </children>
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                </VBox>

                <Label styleClass="field-label" text="%browser">
                    <VBox.margin>
                        <Insets top="12.0" />
                    </VBox.margin>
                </Label>
                <ComboBox fx:id="browserTypeCombo" prefWidth="200.0" />

                <VBox spacing="6.0">
                    <children>
                        <CheckBox fx:id="autoRefreshCheckBox" text="%automatically_refresh_the_preview" />
                        <Label styleClass="field-label" text="%refresh_delay_ms" />
                        <TextField fx:id="autoRefreshDelayField" prefWidth="120.0" />
                    </children>
                    <VBox.margin>
                        <Insets top="12.0" />
                    </VBox.margin>
                </VBox>
            </children>
            <padding>
                <Insets left="12.0" right="12.0" top="8.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
