<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>

<MenuBar fx:id="menuBar" styleClass="base-component" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.MenuBarController">
  <menus>
    <Menu mnemonicParsing="true" text="_File">
      <items>
        <MenuItem mnemonicParsing="true" text="_New..." onAction="#onNew" />
        <MenuItem mnemonicParsing="true" text="_Open" onAction="#onOpen" />
        <Menu fx:id="recentProjectsMenu" mnemonicParsing="true" text="_Recent Projects" />
        <MenuItem mnemonicParsing="true" text="Close _Project" onAction="#onCloseProject" />
        <MenuItem mnemonicParsing="true" text="Close _All Projects" onAction="#onCloseAllProjects" />
        <MenuItem mnemonicParsing="true" text="Close Ot_her Projects" onAction="#onCloseOtherProjects" />
        <SeparatorMenuItem />
        <MenuItem mnemonicParsing="true" text="E_xit" onAction="#onExit" />
      </items>
    </Menu>
    <Menu mnemonicParsing="true" text="_Edit">
      <items>
        <MenuItem mnemonicParsing="true" text="_Delete" />
      </items>
    </Menu>
    <Menu mnemonicParsing="true" text="_Help">
      <items>
        <MenuItem mnemonicParsing="true" text="_About" />
      </items>
    </Menu>
  </menus>
</MenuBar>
