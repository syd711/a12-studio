<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.MenuBarController">
   <left>
      <MenuBar fx:id="menuBar" styleClass="base-component" BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="true" text="_File">
            <items>
              <MenuItem mnemonicParsing="true" onAction="#onNew" text="_New..." />
              <MenuItem mnemonicParsing="true" onAction="#onOpen" text="_Open" />
              <Menu fx:id="recentProjectsMenu" mnemonicParsing="true" text="_Recent Projects" />
              <MenuItem mnemonicParsing="true" onAction="#onCloseProject" text="Close _Project" />
              <SeparatorMenuItem />
              <MenuItem mnemonicParsing="true" onAction="#onExit" text="E_xit" />
            </items>
          </Menu>
          <Menu mnemonicParsing="true" text="_Edit">
            <items>
              <MenuItem mnemonicParsing="true" text="_Delete" />
            </items>
          </Menu>
          <Menu mnemonicParsing="true" text="_Help">
            <items>
              <MenuItem mnemonicParsing="true" text="_About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </left>
   <right>
      <HBox fx:id="menuBarRightPanel" alignment="CENTER_RIGHT" styleClass="dark-panel" BorderPane.alignment="CENTER">
         <children>
            <Button accessibleText="Preferences" mnemonicParsing="false" onAction="#onPreferences" styleClass="default-button">
                <graphic>
                    <FontIcon iconLiteral="mdi2c-cog-outline" iconSize="24" styleClass="toolbar-icon" />
                </graphic>
                <tooltip>
                    <Tooltip text="Preferences" />
                </tooltip>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets right="3.0" />
         </padding>
      </HBox>
   </right>
   <center>
      <HBox styleClass="dark-panel" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
