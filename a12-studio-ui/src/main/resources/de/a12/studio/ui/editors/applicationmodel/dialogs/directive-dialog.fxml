<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="500.0" minWidth="600.0" styleClass="navigation-panel" stylesheets="@../../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.applicationmodel.dialogs.DirectiveDialogController">
   <top>
      <fx:include fx:id="header" source="../../../components/scene-dialog-header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" styleClass="properties-panel" stylesheets="@../../../stylesheet.css">
         <content>
            <VBox spacing="12.0" styleClass="field-editor">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>

               <!-- Type -->
               <VBox>
                  <children>
                     <Label styleClass="field-label" text="%type" />
                     <ComboBox fx:id="typeCombo" maxWidth="Infinity" />
                  </children>
               </VBox>

               <!-- Region -->
               <VBox>
                  <children>
                     <Label styleClass="field-label" text="%region" />
                     <TextField fx:id="regionField" promptText="%comma_separated_region_path_e_g_app_content" />
                  </children>
               </VBox>

               <Label fx:id="genericNoticeLabel" managed="false" styleClass="placeholder-label" text="%this_directive_type_isn_t_fully_supported_by_the_editor_yet_" visible="false" wrapText="true" />

               <!-- REGION_CLEAR: Layout -->
               <VBox fx:id="regionClearSection" spacing="12.0">
                  <children>
                     <Label styleClass="section-header" text="%layout" />
                     <VBox>
                        <children>
                           <Label styleClass="field-label" text="%layout_name" />
                           <ComboBox fx:id="layoutNameCombo" editable="true" maxWidth="Infinity" />
                        </children>
                     </VBox>
                     <VBox>
                        <children>
                           <Label styleClass="field-label" text="%settings_json" />
                           <TextArea fx:id="layoutSettingsArea" prefRowCount="4" wrapText="true" />
                        </children>
                     </VBox>
                  </children>
               </VBox>

               <!-- VIEW_ADD -->
               <VBox fx:id="viewAddSection" spacing="12.0">
                  <children>
                     <VBox>
                        <children>
                           <Label styleClass="field-label" text="%name" />
                           <TextField fx:id="viewAddNameField" promptText="%ui_component_name_e_g_overviewengine" />
                        </children>
                     </VBox>

                     <Label styleClass="section-header" text="%constraints" />
                     <GridPane hgap="10.0" vgap="6.0">
                        <columnConstraints>
                           <ColumnConstraints hgrow="ALWAYS" percentWidth="60.0" />
                           <ColumnConstraints hgrow="ALWAYS" percentWidth="40.0" />
                        </columnConstraints>
                        <rowConstraints>
                           <RowConstraints />
                           <RowConstraints />
                        </rowConstraints>
                        <Label styleClass="field-label" text="%type" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                           <children>
                              <Label styleClass="field-label" text="%preferred_width" />
                              <Label>
                                 <tooltip>
                                    <Tooltip prefWidth="300.0" text="%this_is_for_defining_the_preferred_display_width_of_an_added" wrapText="true" />
                                 </tooltip>
                                 <graphic>
                                    <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
                                 </graphic>
                              </Label>
                           </children>
                        </HBox>
                        <ComboBox fx:id="constraintsTypeCombo" editable="true" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="preferredWidthField" promptText="1-11" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     </GridPane>

                     <Label styleClass="section-header" text="%models" />
                     <GridPane fx:id="modelsGrid" hgap="10.0" vgap="6.0">
                        <columnConstraints>
                           <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
                           <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
                           <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
                           <ColumnConstraints hgrow="NEVER" minWidth="70.0" prefWidth="70.0" />
                        </columnConstraints>
                        <rowConstraints>
                           <RowConstraints />
                        </rowConstraints>
                        <Label styleClass="field-label" text="%model_type" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label styleClass="field-label" text="%name" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label styleClass="field-label" text="%document_model" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                     </GridPane>
                     <Label fx:id="modelsEmptyLabel" styleClass="placeholder-label" text="%there_are_no_entries_yet" />
                     <Button mnemonicParsing="false" onAction="#onAddModel" styleClass="primary-button" text="%add" >
                <tooltip><Tooltip text="%add_model_reference" /></tooltip>
            </Button>

                     <VBox>
                        <children>
                           <Label styleClass="field-label" text="%configuration_json" />
                           <TextArea fx:id="configurationArea" prefRowCount="4" wrapText="true" />
                        </children>
                     </VBox>
                  </children>
               </VBox>
            </VBox>
         </content>
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding>
      </ScrollPane>
   </center>
   <bottom>
      <ToolBar nodeOrientation="RIGHT_TO_LEFT" styleClass="footer-toolbar" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false" onAction="#onDialogSubmit" styleClass="primary-button" text="%ok" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onDialogCancel" styleClass="secondary-button" text="%cancel" />
         </items>
         <padding>
            <Insets bottom="8.0" right="8.0" />
         </padding>
      </ToolBar>
   </bottom>
</BorderPane>
