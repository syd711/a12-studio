<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@/de/a12/studio/ui/stylesheet.css" styleClass="properties-panel"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.CleanupPanelController">
    <center>
        <VBox fx:id="tableContainer" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="placeholder-label" text="%cleanup_description" wrapText="true" />
                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="elementColumn" text="%cleanup_element_column" prefWidth="220.0" />
                        <TableColumn fx:id="reasonColumn" text="%cleanup_reason_column" prefWidth="320.0" />
                    </columns>
                </TableView>
                <Button fx:id="cleanAllButton" text="%cleanup_clean_all" />
            </children>
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
        </VBox>
    </center>
    <top>
        <Label fx:id="noneLabel" styleClass="placeholder-label" text="%cleanup_none" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </BorderPane.margin>
        </Label>
    </top>
</BorderPane>
