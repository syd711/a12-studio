<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.background_image"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <SettingGroup types="Box">
            <TextRow label="%content_settings.url" path="style.backgroundImage" cssUrl="true" secureUrl="true" prompt="%content_settings.paste_url"/>
            <ToggleRow label="%content_settings.repeat" path="style.backgroundRepeat" initial="no-repeat" enabledWhen="style.backgroundImage">
                <ToggleOption value="no-repeat" label="%content_settings.no"/>
                <ToggleOption value="repeat" label="%content_settings.yes"/>
                <ToggleOption value="repeat-x" label="%content_settings.horizontal"/>
                <ToggleOption value="repeat-y" label="%content_settings.vertical"/>
            </ToggleRow>
            <LengthRow label="%content_settings.size" path="style.backgroundSize" keywords="auto,cover,contain" units="px:512,%:100" initial="auto" enabledWhen="style.backgroundImage"/>
            <LengthRow label="%content_settings.horizontal_position" path="style.backgroundPositionX" keywords="left,center,right" units="px:512,%:100" initial="0px" enabledWhen="style.backgroundImage"/>
            <LengthRow label="%content_settings.vertical_position" path="style.backgroundPositionY" keywords="top,center,bottom" units="px:512,%:100" initial="0px" enabledWhen="style.backgroundImage"/>
            </SettingGroup>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
