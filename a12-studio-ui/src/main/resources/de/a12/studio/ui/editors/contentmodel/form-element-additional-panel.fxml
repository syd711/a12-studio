<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.fe_additional"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <SwitchRow label="%content_settings.fe_readonly" path="readonly" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup"/>
            <ToggleRow label="%content_settings.fe_message_exposition" path="messageExposition" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup" initial="DEFAULT" omitInitial="true">
                <ToggleOption value="DEFAULT" label="%content_settings.fe_exposition_default"/>
                <ToggleOption value="TOOLTIP" label="%content_settings.fe_exposition_tooltip"/>
            </ToggleRow>
            <SwitchRow label="%content_settings.fe_tooltips_on_top" path="tooltipsOnTop" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup" showWhen="messageExposition=TOOLTIP"/>
            <ToggleRow label="%content_settings.fe_show_asterisk" path="markingOfRequiredFields" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup" initial="REQUIRED" omitInitial="true">
                <ToggleOption value="REQUIRED" label="%content_settings.fe_asterisk_required"/>
                <ToggleOption value="NONE" label="%content_settings.fe_asterisk_never"/>
                <ToggleOption value="ALWAYS" label="%content_settings.fe_asterisk_always"/>
            </ToggleRow>
            <TextRow label="%content_settings.fe_auto_complete" path="autoComplete" types="TextLine,DatePicker"/>
            <SwitchRow label="%content_settings.fe_secret" path="secret" types="TextLine"/>
            <SwitchRow label="%content_settings.fe_auto_expand" path="autoExpand" types="TextArea"/>
            <SwitchRow label="%content_settings.fe_inline" path="inline" types="Radio,CheckboxGroup"/>
            <SwitchRow label="%content_settings.fe_enable_select_all" path="enableSelectAll" types="CheckboxGroup"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
