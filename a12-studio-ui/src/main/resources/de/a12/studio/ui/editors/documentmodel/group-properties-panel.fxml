<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%properties" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.documentmodel.GroupPropertiesPanelController">
 <BorderPane>
 <center>
  <GridPane hgap="10.0" vgap="8.0">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" percentWidth="30.0" />
      <ColumnConstraints hgrow="ALWAYS" percentWidth="60.0" />
    </columnConstraints>

    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0">
      <Label styleClass="field-label" text="%repetitions" />
      <Spinner fx:id="repetitionsField" editable="true" maxWidth="Infinity" />
    </VBox>
    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0">
      <Label styleClass="field-label" text="%index_field" />
      <ComboBox fx:id="indexFieldComboBox" editable="false" maxWidth="Infinity" />
    </VBox>

    <rowConstraints>
       <RowConstraints />
    </rowConstraints>
  </GridPane>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
