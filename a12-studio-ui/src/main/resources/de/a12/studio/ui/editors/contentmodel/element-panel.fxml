<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.element"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ElementPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="4.0">
                <children>
                    <Label styleClass="field-label" text="%id" />
                    <TextField fx:id="elementIdField" editable="false" />
                    <Label styleClass="field-label" text="%type" />
                    <ComboBox fx:id="elementTypeField" maxWidth="Infinity" />
                    <Label styleClass="field-label" text="%namespace" />
                    <TextField fx:id="elementNamespaceField" editable="false" />
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
