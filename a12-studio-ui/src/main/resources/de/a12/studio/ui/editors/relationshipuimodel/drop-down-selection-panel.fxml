<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%drop_down_selection"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.relationshipuimodel.DropDownSelectionPanelController">
    <BorderPane>
        <center>
            <VBox spacing="14.0">
                <children>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%available_items_query_model"/>
                            <ComboBox fx:id="availableItemsQueryField" editable="false" maxWidth="Infinity"/>
                        </children>
                    </VBox>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%selected_item_query_model"/>
                            <ComboBox fx:id="selectedItemQueryField" editable="false" maxWidth="Infinity"/>
                        </children>
                    </VBox>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="%element_reference"/>
                            <TextField fx:id="elementRefField"/>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </center>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml"
                        BorderPane.alignment="CENTER"/>
        </top>
    </BorderPane>
</TitledPane>
