<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            text="%repeat_column_display" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.RepeatColumnDisplayPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="10.0">
                <CheckBox fx:id="labelHiddenCheckBox" mnemonicParsing="false" text="%hide_label" />
                <CheckBox fx:id="fixedWidthCheckBox" mnemonicParsing="false" text="%fixed_width" />
                <VBox spacing="2.0">
                    <Label styleClass="field-label" text="%repeat_column_filter_exposition" />
                    <ComboBox fx:id="filterExpositionCombo" maxWidth="Infinity" />
                </VBox>
                <padding>
                    <Insets bottom="4.0" top="4.0" />
                </padding>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
