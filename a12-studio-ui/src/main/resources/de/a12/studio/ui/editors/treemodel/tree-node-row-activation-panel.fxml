<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%tree_node_row_activation_panel.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeNodeRowActivationPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="10.0">
                <children>
                    <VBox spacing="2.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="6.0">
                                <children>
                                    <Label styleClass="field-label" text="%tree_node_row_activation_panel.type" />
                                    <Label fx:id="typeInfoIcon" />
                                </children>
                            </HBox>
                            <ComboBox fx:id="typeField" maxWidth="Infinity" />
                        </children>
                    </VBox>
                    <VBox fx:id="eventBox" spacing="2.0">
                        <children>
                            <Label styleClass="field-label" text="%event" />
                            <ComboBox fx:id="eventField" maxWidth="Infinity" promptText="%event" />
                        </children>
                    </VBox>
                    <VBox fx:id="positionBox" spacing="2.0">
                        <children>
                            <Label styleClass="field-label" text="%tree_node_action.position" />
                            <ComboBox fx:id="positionField" maxWidth="Infinity" />
                        </children>
                    </VBox>
                    <VBox fx:id="documentModelBox" spacing="2.0">
                        <children>
                            <Label styleClass="field-label" text="%document_model" />
                            <ComboBox fx:id="documentModelField" maxWidth="Infinity" promptText="%tree_node_action.default_document_model" />
                        </children>
                    </VBox>
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
