<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component, sidebar-panel" stylesheets="@/de/a12/studio/ui/stylesheet.css"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.bookmarks.BookmarksPanelController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <ToolBar prefHeight="40.0" prefWidth="200.0">
                <items>
                    <Button accessibleText="%bookmark_rename" mnemonicParsing="false"
                            onAction="#onRename" styleClass="default-button">
                        <graphic>
                            <FontIcon iconLiteral="mdi2r-rename-box" iconSize="18" styleClass="toolbar-icon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="%bookmark_rename" />
                        </tooltip>
                    </Button>
                    <Button accessibleText="%bookmark_delete" mnemonicParsing="false"
                            onAction="#onDelete" styleClass="default-button">
                        <graphic>
                            <FontIcon iconLiteral="mdi2d-delete-outline" iconSize="18" styleClass="toolbar-icon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="%bookmark_delete" />
                        </tooltip>
                    </Button>
                    <Region HBox.hgrow="ALWAYS" />
                    <Separator orientation="VERTICAL" />
                    <Button fx:id="collapseProjectViewButton" accessibleText="%collapse_project_view" mnemonicParsing="false"
                            onAction="#onCollapseProjectView" styleClass="default-button">
                        <graphic>
                            <FontIcon iconLiteral="mdi2w-window-minimize" iconSize="18" styleClass="toolbar-icon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="%collapse_project_view" />
                        </tooltip>
                    </Button>
                </items>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <ListView fx:id="bookmarkList" />
    </center>
</BorderPane>
