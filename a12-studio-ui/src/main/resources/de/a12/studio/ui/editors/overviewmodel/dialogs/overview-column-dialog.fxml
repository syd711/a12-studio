<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?><?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" maxWidth="Infinity" minHeight="760.0" minWidth="700.0" styleClass="navigation-panel"
            stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.overviewmodel.dialogs.OverviewColumnDialogController">
   <top>
      <fx:include fx:id="header" source="/de/a12/studio/ui/components/scene-dialog-header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" styleClass="properties-panel" stylesheets="@/de/a12/studio/ui/stylesheet.css" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="14.0" styleClass="field-editor">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>

               <!-- Column Type / Target Document Model -->
               <HBox spacing="12.0">
                  <children>
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="field-label" text="%column_type" />
                           <ComboBox fx:id="columnTypeCombo" maxWidth="Infinity" />
                        </children>
                     </VBox>
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="field-label" text="%target_document_model" />
                           <TextField fx:id="targetDocumentModelField" disable="true" editable="false" focusTraversable="false" />
                        </children>
                     </VBox>
                  </children>
               </HBox>

               <!-- Reference Column fields -->
               <VBox fx:id="referenceSection" spacing="14.0">
                  <children>
                     <VBox spacing="2.0">
                        <children>
                           <Label styleClass="field-label" text="%element_reference" />
                           <ComboBox fx:id="elementRefCombo" maxWidth="Infinity" />
                        </children>
                     </VBox>
                     <HBox spacing="12.0">
                        <children>
                           <VBox alignment="BOTTOM_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <CheckBox fx:id="sortableField" mnemonicParsing="false" text="%sortable" />
                              </children>
                              <HBox.margin>
                                 <Insets bottom="8.0" />
                              </HBox.margin>
                           </VBox>
                           <VBox fx:id="preferredSortingBox" spacing="2.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label styleClass="field-label" text="%preferred_sorting" />
                                 <ComboBox fx:id="preferredSortingCombo" maxWidth="Infinity" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                  </children>
               </VBox>

               <!-- Expression Column fields -->
               <VBox fx:id="expressionSection" spacing="14.0">
                  <children>
                     <VBox spacing="2.0">
                        <children>
                           <Label styleClass="field-label" text="%name" />
                           <TextField fx:id="nameField" promptText="%distinguishes_this_column_from_others_e_g_fullname" />
                        </children>
                     </VBox>
                     <fx:include fx:id="expressionPanel" source="../../propertyeditors/richtext-editor.fxml" />
                  </children>
               </VBox>

               <!-- ID -->
               <HBox spacing="12.0">
                  <children>
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="field-label" text="%id" />
                           <TextField fx:id="idField" disable="true" editable="false" focusTraversable="false" />
                        </children>
                     </VBox>
                  </children>
               </HBox>

               <!-- Icon -->
               <fx:include fx:id="iconPanel" source="../../propertyeditors/icon-panel.fxml" />

               <!-- Pin Direction / Width / Fixed Width -->
               <HBox spacing="12.0">
                  <children>
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="field-label" text="%pin_direction" />
                           <ComboBox fx:id="pinDirectionCombo" maxWidth="Infinity" />
                        </children>
                     </VBox>
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="field-label" text="%width" />
                           <TextField fx:id="widthField" />
                        </children>
                     </VBox>
                     <VBox fx:id="fixedWidthBox" alignment="BOTTOM_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <CheckBox fx:id="fixedWidthField" mnemonicParsing="false" text="%fixed_width" />
                        </children>
                        <HBox.margin>
                           <Insets bottom="8.0" />
                        </HBox.margin>
                     </VBox>
                  </children>
               </HBox>

               <!-- Label -->
               <VBox spacing="6.0">
                  <children>
                     <fx:include fx:id="label" source="../../propertyeditors/localized-text-panel.fxml" />
                     <CheckBox fx:id="hideLabelField" mnemonicParsing="false" text="%hide_label" />
                  </children>
               </VBox>

               <!-- Alignment -->
               <VBox spacing="10.0">
                  <children>
                     <Label styleClass="section-header" text="%horizontal_alignment" />
                     <HBox spacing="12.0">
                        <children>
                           <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label styleClass="field-label" text="%header" />
                                 <ComboBox fx:id="horizontalHeaderCombo" maxWidth="Infinity" />
                              </children>
                           </VBox>
                           <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label styleClass="field-label" text="%content" />
                                 <ComboBox fx:id="horizontalContentCombo" maxWidth="Infinity" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>

                     <Label styleClass="section-header" text="%vertical_alignment" />
                     <HBox spacing="12.0">
                        <children>
                           <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label styleClass="field-label" text="%header" />
                                 <ComboBox fx:id="verticalHeaderCombo" maxWidth="Infinity" />
                              </children>
                           </VBox>
                           <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label styleClass="field-label" text="%content" />
                                 <ComboBox fx:id="verticalContentCombo" maxWidth="Infinity" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                  </children>
               </VBox>

               <!-- Styles -->
               <VBox spacing="10.0">
                  <children>
                     <fx:include fx:id="stylesHeader" source="../styles-panel.fxml" />
                     <fx:include fx:id="stylesContent" source="../styles-panel.fxml" />
                  </children>
               </VBox>
            </VBox>
         </content>
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding>
      </ScrollPane>
   </center>
   <bottom>
      <ToolBar nodeOrientation="RIGHT_TO_LEFT" styleClass="footer-toolbar" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false" onAction="#onDialogSubmit" styleClass="primary-button" text="%ok" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onDialogCancel" styleClass="secondary-button" text="%cancel" />
         </items>
         <padding>
            <Insets bottom="8.0" right="8.0" />
         </padding>
      </ToolBar>
   </bottom>
</BorderPane>
