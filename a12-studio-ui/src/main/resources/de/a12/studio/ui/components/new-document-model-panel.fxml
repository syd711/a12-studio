<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="0.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.a12.studio.ui.components.NewDocumentModelPanelController">

    <!-- Model name -->
    <Label styleClass="field-label" text="%name" />
    <TextField fx:id="modelNameField" promptText="%new_document_model_panel.name_prompt">
        <VBox.margin><Insets top="4.0" /></VBox.margin>
        <font><Font size="14.0" /></font>
    </TextField>

    <!-- Location -->
    <Label styleClass="field-label" text="%location">
        <VBox.margin><Insets top="14.0" /></VBox.margin>
    </Label>
    <ComboBox fx:id="locationCombo" maxWidth="1.7976931348623157E308" promptText="%select_a_location">
        <VBox.margin><Insets top="4.0" /></VBox.margin>
    </ComboBox>

    <VBox spacing="24.0">
        <VBox.margin><Insets top="24.0" /></VBox.margin>
        <fx:include fx:id="locales" source="/de/a12/studio/ui/editors/propertyeditors/locales-panel.fxml" />
        <fx:include fx:id="roles" source="/de/a12/studio/ui/editors/propertyeditors/roles-panel.fxml" />
    </VBox>
</VBox>
