<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.querymodel.QueryModelEditorController">
    <right>
        <ToolBar orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <StackPane>
                    <children>
                        <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#onSettings" styleClass="default-button">
                            <graphic>
                                <FontIcon iconLiteral="mdi2c-cog" iconSize="18" />
                            </graphic>
                            <tooltip>
                                <Tooltip fx:id="settingsButtonTooltip" text="Model Settings" />
                            </tooltip>
                        </Button>
                        <Circle fx:id="settingsErrorBadge" mouseTransparent="true" radius="4" styleClass="toolbar-button-error-badge" translateX="10" translateY="-10" visible="false" StackPane.alignment="CENTER" />
                    </children>
                </StackPane>
                <Separator prefHeight="0.0" prefWidth="0.0" />
                <fx:include fx:id="fileToolbarButtons" source="../editor-file-toolbar-buttons.fxml" />
            </items>
        </ToolBar>
    </right>
    <center>
        <Label styleClass="section-label" text="Query Model editing is not implemented yet." BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
