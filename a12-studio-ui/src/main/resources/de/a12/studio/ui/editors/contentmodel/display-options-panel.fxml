<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.display_options"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <ToggleRow label="%content_settings.display_format" path="displayOption" types="FieldOutput" initial="label-value">
                <ToggleOption value="value-only" label="%content_settings.value_only"/>
                <ToggleOption value="label-value" label="%content_settings.with_label"/>
            </ToggleRow>
            <TextRow label="%content_settings.default_text" path="missingValueText" types="FieldOutput" prompt="%content_settings.text_when_field_is_empty"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
