<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.auth.RolesEditorController">
    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <items>
                <Button mnemonicParsing="false" onAction="#onAddRole" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2p-plus" iconSize="18" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Add Role" />
                    </tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#onEditRole" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2p-pencil-outline" iconSize="18" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Edit Role" />
                    </tooltip>
                </Button>
                <Button mnemonicParsing="false" onAction="#onDeleteRole" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="18" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Delete Role" />
                    </tooltip>
                </Button>
            </items>
        </ToolBar>
    </top>
    <right>
        <ToolBar orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <fx:include fx:id="fileToolbarButtons" source="../editor-file-toolbar-buttons.fxml" />
            </items>
        </ToolBar>
    </right>
    <center>
        <SplitPane dividerPositions="0.6" BorderPane.alignment="CENTER">
            <items>
                <TableView fx:id="rolesTable">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="180.0" />
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="320.0" />
                    </columns>
                </TableView>
                <VBox spacing="8.0" styleClass="field-editor">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <Label fx:id="accessRightsLabel" text="Access Rights" />
                        <ListView fx:id="accessRightsList" VBox.vgrow="ALWAYS" />
                        <HBox spacing="8.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onAddAccessRight" text="Add" />
                                <Button mnemonicParsing="false" onAction="#onRemoveAccessRight" text="Remove" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
