<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="700.0" minWidth="650.0" styleClass="navigation-panel" stylesheets="@../../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.applicationmodel.dialogs.SceneDialogController">
   <top>
      <fx:include fx:id="header" source="../../../components/scene-dialog-header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" styleClass="properties-panel" stylesheets="@../../../stylesheet.css">
         <content>
            <VBox spacing="12.0" styleClass="field-editor">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>

               <!-- Name -->
               <VBox>
                  <children>
                     <Label styleClass="field-label" text="%name" />
                     <TextField fx:id="nameField" promptText="%enter_the_scene_name_here" />
                  </children>
               </VBox>

               <!-- Description -->
               <VBox>
                  <children>
                     <Label styleClass="field-label" text="%description" />
                     <TextField fx:id="descriptionField" promptText="%enter_a_description_here" />
                  </children>
               </VBox>

               <!-- Prior Scene -->
               <VBox>
                  <children>
                     <Label styleClass="field-label" text="%prior_scene" />
                     <ComboBox fx:id="priorSceneCombo" maxWidth="Infinity" />
                  </children>
               </VBox>

               <!-- Default Case -->
               <VBox>
                  <children>
                     <Label styleClass="field-label" text="%default_case" />
                     <ComboBox fx:id="defaultCaseCombo" maxWidth="Infinity" />
                  </children>
               </VBox>

               <!-- Match Conditions -->
               <fx:include fx:id="matchConditions" source="../match-conditions-panel.fxml" />

               <!-- Scene Change -->
               <fx:include fx:id="sceneChange" source="../scene-change-panel.fxml" />

               <!-- Cases -->
               <fx:include fx:id="cases" source="../cases-panel.fxml" />
            </VBox>
         </content>
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding>
      </ScrollPane>
   </center>
   <bottom>
      <ToolBar nodeOrientation="RIGHT_TO_LEFT" styleClass="footer-toolbar" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false" onAction="#onDialogSubmit" styleClass="primary-button" text="%ok" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onDialogCancel" styleClass="secondary-button" text="%cancel" />
         </items>
         <padding>
            <Insets bottom="8.0" right="8.0" />
         </padding>
      </ToolBar>
   </bottom>
</BorderPane>
