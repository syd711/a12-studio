<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.mgc_title"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <NoteRow text="%content_settings.mgc_note" types="MessageGroupContainer"/>
            <NoteRow text="%content_settings.mgc_note_scope" types="MessageGroupContainer"/>
            <SwitchRow label="%content_settings.fe_ignore_formal_errors" path="ignoreFormalErrors" types="MessageGroupContainer"/>
            <SwitchRow label="%content_settings.mgc_auto_collect" path="autoCollectNodes" types="MessageGroupContainer"/>
            <CollectedRow label="%content_settings.mgc_collected_fields" groups="false" types="MessageGroupContainer" showWhen="autoCollectNodes=true"/>
            <CollectedRow label="%content_settings.mgc_collected_groups" groups="true" types="MessageGroupContainer" showWhen="autoCollectNodes=true"/>
            <ListRow label="%content_settings.mgc_fields" path="fields" kind="FIELD" types="MessageGroupContainer"/>
            <ListRow label="%content_settings.mgc_groups" path="groups" kind="GROUP" types="MessageGroupContainer"/>
            <ListRow label="%content_settings.mgc_rules" path="rules" kind="TEXT" types="MessageGroupContainer"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
