<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.versioncontrol.VersioncontrolHistoryPanelController">
    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <items>
                <FontIcon iconLiteral="mdi2h-history" iconSize="16" styleClass="toolbar-icon" />
                <Label text="%versioncontrol_history" />
                <Label fx:id="historyScopeLabel" styleClass="versioncontrol-history-scope" />
                <Button fx:id="clearHistoryScopeButton" accessibleText="%versioncontrol_history_show_all" mnemonicParsing="false" onAction="#onClearHistoryScope" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-close" iconSize="14" styleClass="toolbar-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="%versioncontrol_history_show_all" />
                    </tooltip>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="collapseHistoryButton" accessibleText="%versioncontrol_history_collapse" mnemonicParsing="false" onAction="#onCollapseHistory" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2w-window-minimize" iconSize="18" styleClass="toolbar-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="%versioncontrol_history_collapse" />
                    </tooltip>
                </Button>
            </items>
        </ToolBar>
    </top>
    <center>
        <TableView fx:id="historyTable" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="historyMessageColumn" text="%versioncontrol_history_message" />
                <TableColumn fx:id="historyAuthorColumn" text="%versioncontrol_history_author" />
                <TableColumn fx:id="historyDateColumn" text="%versioncontrol_history_date" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
