<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%row_height_and_action_column_width" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeRowHeightActionColumnWidthPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <GridPane hgap="24.0" vgap="4.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                </columnConstraints>
                <children>
                    <Label styleClass="field-label" text="%row_height" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <children>
                            <TextField fx:id="rowHeightField" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label text="%px" />
                            <Label fx:id="rowHeightInfoIcon" />
                        </children>
                    </HBox>
                    <Label styleClass="field-label" text="%action_column_width" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <children>
                            <TextField fx:id="actionColumnWidthField" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                            <Label fx:id="actionColumnWidthInfoIcon" />
                        </children>
                    </HBox>
                </children>
            </GridPane>
        </center>
    </BorderPane>
</TitledPane>
