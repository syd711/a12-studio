<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%tree_pagination_panel.title" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreePaginationPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="10.0">
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <CheckBox fx:id="paginationField" mnemonicParsing="false" text="%tree_pagination_panel.enable" />
                    <Label fx:id="infoIcon" />
                </HBox>
                <VBox fx:id="pageSizeBox" maxWidth="200.0" spacing="4.0">
                    <Label styleClass="field-label" text="%page_size" />
                    <Spinner fx:id="pageSizeField" editable="true" maxWidth="Infinity" />
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
