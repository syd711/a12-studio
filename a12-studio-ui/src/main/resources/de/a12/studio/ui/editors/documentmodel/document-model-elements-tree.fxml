<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.documentmodel.DocumentModelElementsTreeController">
    <top>
        <ToolBar fx:id="modelTreeToolbarBar" prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <items>
                <MenuButton fx:id="modelTreeAddButton" mnemonicParsing="false" text="Add" />
            </items>
        </ToolBar>
    </top>
   <center>
      <TreeTableView fx:id="elementsTreeTable" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TreeTableColumn fx:id="nameColumn" prefWidth="350.0" text="Name" />
          <TreeTableColumn fx:id="typeColumn" prefWidth="80.0" text="Data Type" />
        </columns>
      </TreeTableView>
   </center>
</BorderPane>
