<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.BorderPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.documentmodel.DocumentModelElementsTreeController">
    <top>
        <ToolBar fx:id="modelTreeToolbarBar" styleClass="panel-toolbar" BorderPane.alignment="CENTER">
            <items>
                <Button fx:id="undoButton" accessibleText="Undo" mnemonicParsing="false" onAction="#onUndo" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2u-undo" iconSize="18" styleClass="toolbar-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Undo" />
                    </tooltip>
                </Button>
                <Button fx:id="redoButton" accessibleText="Redo" mnemonicParsing="false" onAction="#onRedo" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2r-redo" iconSize="18" styleClass="toolbar-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Redo" />
                    </tooltip>
                </Button>
                <Separator orientation="VERTICAL" />
                <MenuButton fx:id="modelTreeAddButton" mnemonicParsing="false" styleClass="primary-button" text="Add" />
            <Separator layoutX="145.0" layoutY="10.0" orientation="VERTICAL" />
                <TextField fx:id="searchField" prefWidth="160.0" promptText="Search" styleClass="search-field" />
                <Button fx:id="resetSearchButton" accessibleText="Clear search" mnemonicParsing="false" onAction="#onResetSearch" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-close" iconSize="14" styleClass="toolbar-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Clear search" />
                    </tooltip>
                </Button>
            </items>
        </ToolBar>
    </top>
   <center>
      <TreeTableView fx:id="elementsTreeTable">
        <columns>
          <TreeTableColumn fx:id="nameColumn" prefWidth="350.0" text="NAME" />
          <TreeTableColumn fx:id="typeColumn" prefWidth="80.0" text="DATA TYPE" />
            <TreeTableColumn fx:id="spacerColumn" prefWidth="400.0" />
        </columns>
      </TreeTableView>
   </center>
</BorderPane>
