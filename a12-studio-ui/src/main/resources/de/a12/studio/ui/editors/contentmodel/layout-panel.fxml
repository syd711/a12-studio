<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.layout"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <ToggleRow label="%content_settings.direction" path="style.flexDirection" types="Box" initial="column">
                <ToggleOption value="row" label="%content_settings.horizontal"/>
                <ToggleOption value="column" label="%content_settings.vertical"/>
            </ToggleRow>
            <LengthRow label="%content_settings.distribution" path="style.justifyContent" types="Box" allowUnspecified="false" keywords="start,center,end,space-between,space-around,space-evenly" initial="start"/>
            <ToggleRow label="%content_settings.alignment" path="style.alignItems" types="Box,ButtonGroupContainer" initial="flex-start">
                <ToggleOption value="flex-start" label="%content_settings.start"/>
                <ToggleOption value="center" label="%content_settings.center"/>
                <ToggleOption value="flex-end" label="%content_settings.end"/>
            </ToggleRow>
            <LengthRow label="%content_settings.gap" path="style.gap" types="Box,ButtonGroupContainer,ButtonGroup" units="px:0,%:0"/>
            <ToggleRow label="%content_settings.wrap" path="style.flexWrap" types="Box" initial="nowrap">
                <ToggleOption value="wrap" label="%content_settings.yes"/>
                <ToggleOption value="nowrap" label="%content_settings.no"/>
            </ToggleRow>
            <LengthRow label="%content_settings.overflow" path="style.overflow" types="Box" allowUnspecified="false" keywords="visible,hidden,scroll,auto" initial="visible"/>
            <ToggleRow label="%content_settings.alignment" path="alignment" types="FieldOutput" initial="left">
                <ToggleOption value="left" label="%content_settings.left"/>
                <ToggleOption value="center" label="%content_settings.center"/>
                <ToggleOption value="right" label="%content_settings.right"/>
            </ToggleRow>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
