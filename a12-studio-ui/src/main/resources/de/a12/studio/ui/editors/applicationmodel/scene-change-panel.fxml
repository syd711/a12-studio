<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="SCENE CHANGE" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.applicationmodel.SceneChangePanelController">
 <BorderPane>
 <center>
  <VBox spacing="16.0">
    <!-- On Enter -->
    <VBox spacing="10.0">
      <children>
        <Label styleClass="section-header" text="On Enter" />
        <HBox fx:id="onEnterColumnHeaders" spacing="10.0">
          <Label styleClass="field-label" text="Type" />
          <Label styleClass="field-label" text="Region" />
          <Label styleClass="field-label" text="Name" />
        </HBox>
        <VBox fx:id="onEnterRows" spacing="8.0" />
        <Label fx:id="onEnterEmptyLabel" styleClass="placeholder-label" text="There are no entries yet." />
        <Button mnemonicParsing="false" onAction="#onAddOnEnter" styleClass="primary-button" text="Add" />
      </children>
    </VBox>

    <!-- On Exit -->
    <VBox fx:id="onExitSection" spacing="10.0">
      <children>
        <Label styleClass="section-header" text="On Exit" />
        <HBox fx:id="onExitColumnHeaders" spacing="10.0">
          <Label styleClass="field-label" text="Type" />
          <Label styleClass="field-label" text="Region" />
          <Label styleClass="field-label" text="Name" />
        </HBox>
        <VBox fx:id="onExitRows" spacing="8.0" />
        <Label fx:id="onExitEmptyLabel" styleClass="placeholder-label" text="There are no entries yet." />
        <Button mnemonicParsing="false" onAction="#onAddOnExit" styleClass="primary-button" text="Add" />
      </children>
    </VBox>
  </VBox>
 </center>
 </BorderPane>
</TitledPane>
