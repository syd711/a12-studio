<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%scene_change" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.applicationmodel.SceneChangePanelController">
 <BorderPane>
 <center>
  <VBox spacing="16.0">
    <!-- On Enter -->
    <VBox spacing="10.0">
      <children>
        <Label styleClass="section-header" text="%on_enter" />
        <HBox fx:id="onEnterColumnHeaders" spacing="10.0">
          <Label styleClass="field-label" text="%type" />
          <Label styleClass="field-label" text="%region" />
          <Label styleClass="field-label" text="%name" />
        </HBox>
        <VBox fx:id="onEnterRows" spacing="8.0" />
        <Label fx:id="onEnterEmptyLabel" styleClass="placeholder-label" text="%there_are_no_entries_yet" />
        <Button mnemonicParsing="false" onAction="#onAddOnEnter" styleClass="primary-button" text="%add_on_enter_scene_change" >
                <graphic><FontIcon iconColor="#FFFFFF" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
                <tooltip><Tooltip text="%add_on_enter_scene_change" /></tooltip>
            </Button>
      </children>
    </VBox>

    <!-- On Exit -->
    <VBox fx:id="onExitSection" spacing="10.0">
      <children>
        <Label styleClass="section-header" text="%on_exit" />
        <HBox fx:id="onExitColumnHeaders" spacing="10.0">
          <Label styleClass="field-label" text="%type" />
          <Label styleClass="field-label" text="%region" />
          <Label styleClass="field-label" text="%name" />
        </HBox>
        <VBox fx:id="onExitRows" spacing="8.0" />
        <Label fx:id="onExitEmptyLabel" styleClass="placeholder-label" text="%there_are_no_entries_yet" />
        <Button mnemonicParsing="false" onAction="#onAddOnExit" styleClass="primary-button" text="%add_on_exit_scene_change" >
                <graphic><FontIcon iconColor="#FFFFFF" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
                <tooltip><Tooltip text="%add_on_exit_scene_change" /></tooltip>
            </Button>
      </children>
    </VBox>
  </VBox>
 </center>
 </BorderPane>
</TitledPane>
