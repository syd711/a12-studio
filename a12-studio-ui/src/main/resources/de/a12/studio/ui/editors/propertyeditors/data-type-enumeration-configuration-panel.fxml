<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="CATEGORY" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.DataTypeEnumerationConfigurationPanelController">
 <BorderPane>
 <center>
  <VBox spacing="14.0">
    <VBox spacing="8.0">
      <HBox fx:id="categoryColumnHeaders" spacing="10.0">
        <Label styleClass="field-label" text="Name" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        <Label styleClass="field-label" text="Description" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
      </HBox>
      <VBox fx:id="categoryRows" spacing="8.0" />
      <HBox spacing="8.0">
        <Button fx:id="addCategoryButton" mnemonicParsing="false" onAction="#onAddCategory" styleClass="primary-button" text="Add" />
      </HBox>
    </VBox>

    <TitledPane fx:id="enumerationValuesPane" maxWidth="Infinity" text="ENUMERATION VALUES">
      <VBox spacing="10.0">
        <padding>
          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
        <HBox spacing="8.0" fx:id="buttonPanel">
          <Button fx:id="fillEmptyTextsButton" mnemonicParsing="false" onAction="#onFillEmptyTexts" styleClass="secondary-button" text="Fill Empty Texts" />
        </HBox>
        <GridPane fx:id="enumerationValuesGrid" hgap="10.0" vgap="6.0" />
        <Label fx:id="enumerationValuesEmptyLabel" styleClass="placeholder-label" text="There are no entries yet." />
        <HBox spacing="8.0">
          <Button fx:id="addValueButton" mnemonicParsing="false" onAction="#onAddValue" styleClass="primary-button" text="Add" />
        </HBox>
      </VBox>
      <VBox.margin>
        <Insets left="-8.0" />
      </VBox.margin>
    </TitledPane>

    <CheckBox fx:id="alphabeticalSortingCheckBox" text="Alphabetical Sorting" />
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
