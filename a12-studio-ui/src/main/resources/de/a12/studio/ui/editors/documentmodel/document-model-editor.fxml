<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.documentmodel.DocumentModelEditorController">
    <right>
        <ToolBar orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <fx:include fx:id="settingsToolbarButton" source="../editor-settings-toolbar-button.fxml" />
                <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onTypeDefinitions" styleClass="action-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2p-puzzle" iconSize="18" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="%type_definitions" />
                    </tooltip>
                </Button>
                <Separator prefHeight="0.0" prefWidth="0.0" />
                <fx:include fx:id="fileToolbarButtons" source="../editor-file-toolbar-buttons.fxml" />
            </items>
        </ToolBar>
    </right>
    <center>
        <BorderPane BorderPane.alignment="CENTER">
            <center>
                <SplitPane fx:id="splitPane" dividerPositions="0.5" BorderPane.alignment="CENTER">
                    <items>
                        <fx:include fx:id="elementsTree" source="document-model-elements-tree.fxml" />
                        <BorderPane fx:id="editorContainer" />
                    </items>
                </SplitPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
