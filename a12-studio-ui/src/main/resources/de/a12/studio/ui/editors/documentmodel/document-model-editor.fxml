<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import de.a12.studio.ui.editors.EditorFileToolbarButtons?>

<BorderPane stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.documentmodel.DocumentModelEditorController">
    <right>
        <ToolBar orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <StackPane>
                    <children>
                        <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#onSettings" styleClass="default-button">
                            <graphic>
                                <FontIcon iconLiteral="mdi2c-cog" iconSize="18" />
                            </graphic>
                            <tooltip>
                                <Tooltip fx:id="settingsButtonTooltip" text="Model Settings" />
                            </tooltip>
                        </Button>
                        <Circle fx:id="settingsErrorBadge" mouseTransparent="true" radius="4" styleClass="toolbar-button-error-badge" translateX="10" translateY="-10" visible="false" StackPane.alignment="CENTER" />
                    </children>
                </StackPane>
                <Button layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#onTypeDefinitions" styleClass="default-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2p-puzzle" iconSize="18" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Type Definitions" />
                    </tooltip>
                </Button>
                <EditorFileToolbarButtons fx:id="fileToolbarButtons" />
            </items>
        </ToolBar>
    </right>
    <center>
        <BorderPane BorderPane.alignment="CENTER">
            <center>
                <SplitPane fx:id="splitPane" dividerPositions="0.5" BorderPane.alignment="CENTER">
                    <items>
                        <fx:include fx:id="elementsTree" source="document-model-elements-tree.fxml" />
                        <BorderPane fx:id="editorContainer" />
                    </items>
                </SplitPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
