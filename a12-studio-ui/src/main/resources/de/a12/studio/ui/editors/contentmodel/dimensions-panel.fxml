<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.dimensions"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <LengthRow label="%content_settings.width" path="style.width" types="Box,Grid,GridRow,Table,MessageBox,Image,Button,ButtonGroup,ButtonGroupContainer,Video" keywords="auto" units="px:400,%:100"/>
            <LengthRow label="%content_settings.height" path="style.height" types="Box,GridRow,MessageBox,Image,Button,ButtonGroup,ButtonGroupContainer" keywords="auto,fit-content" units="px:400,%:100"/>
            <SpacingRow label="%content_settings.padding" path="style.padding" types="Box,Grid,GridRow,GridColumn,Paragraph,Heading,ListItem,OrderedList,UnorderedList,Table,MessageBox,Image,Button,ButtonGroup,ButtonGroupContainer,Link,Expandable,FieldOutput,InteractiveList" units="px:0,%:0,rem:0"/>
            <SpacingRow label="%content_settings.margin" path="style.margin" types="Box,Grid,GridRow,Paragraph,Heading,ListItem,OrderedList,UnorderedList,Table,MessageBox,Image,Button,ButtonGroup,ButtonGroupContainer,Link,Expandable,FieldOutput,InteractiveList,InteractiveListItem,InteractiveTile,Video" keywords="auto" units="px:0,%:0,rem:0"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
