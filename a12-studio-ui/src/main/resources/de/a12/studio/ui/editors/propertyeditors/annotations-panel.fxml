<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="false" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="ANNOTATIONS" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.AnnotationsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <GridPane fx:id="annotationsGrid" hgap="10.0" vgap="6.0">
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="39.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="36.0" />
        <ColumnConstraints hgrow="NEVER" minWidth="150.0" prefWidth="150.0" />
      </columnConstraints>
      <rowConstraints>
        <RowConstraints />
      </rowConstraints>
      <Label styleClass="field-label" text="Name*" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <Label styleClass="field-label" text="Value" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    </GridPane>
    <Label fx:id="emptyLabel" styleClass="placeholder-label" text="There are no entries yet." />
    <HBox spacing="8.0">
      <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAdd" styleClass="primary-button" text="Add" >
                <tooltip><Tooltip text="Add annotation" /></tooltip>
            </Button>
      <Button fx:id="annotationDatasetsButton" mnemonicParsing="false" onAction="#onAnnotationDatasets" styleClass="secondary-button" text="Annotation Datasets" >
                <tooltip><Tooltip text="Open annotation datasets" /></tooltip>
            </Button>
    </HBox>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
