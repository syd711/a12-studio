<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox resources="messages" fx:id="root" spacing="6.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.EditorFileToolbarButtonsController">
    <Button mnemonicParsing="false" onAction="#onFileEdit" styleClass="default-button">
        <graphic>
            <FontIcon iconLiteral="mdi2f-file-edit-outline" iconSize="18" />
        </graphic>
        <tooltip>
            <Tooltip text="%edit_file" />
        </tooltip>
    </Button>
    <Button mnemonicParsing="false" onAction="#onFileOpen" styleClass="default-button">
        <graphic>
            <FontIcon iconLiteral="mdi2f-folder-open-outline" iconSize="18" />
        </graphic>
        <tooltip>
            <Tooltip text="%open_model_folder" />
        </tooltip>
    </Button>
</VBox>
