<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" maxHeight="Infinity" maxWidth="Infinity" minHeight="640.0" minWidth="640.0" styleClass="navigation-panel" stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.overviewmodel.dialogs.FilterGroupDialogController">
   <top>
      <fx:include fx:id="header" source="/de/a12/studio/ui/components/scene-dialog-header.fxml" />
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="properties-panel" stylesheets="@/de/a12/studio/ui/stylesheet.css" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="14.0" styleClass="field-editor">
               <padding>
                  <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
               </padding>

               <!-- Name / Group ID -->
               <HBox spacing="12.0">
                  <children>
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="field-label" text="%name" />
                           <TextField fx:id="nameField" />
                        </children>
                     </VBox>
                     <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label styleClass="field-label" text="%group_id" />
                           <HBox alignment="CENTER_LEFT" spacing="6.0">
                              <children>
                                 <TextField fx:id="groupIdField" editable="false" styleClass="readonly-field" HBox.hgrow="ALWAYS" />
                                 <Button fx:id="copyGroupIdButton" mnemonicParsing="false" onAction="#onCopyGroupId" styleClass="default-button">
                                    <graphic><FontIcon iconLiteral="mdi2c-content-copy" iconSize="16" /></graphic>
                                    <tooltip><Tooltip text="%copy" /></tooltip>
                                 </Button>
                              </children>
                           </HBox>
                        </children>
                     </VBox>
                  </children>
               </HBox>

               <!-- Label -->
               <fx:include fx:id="label" source="../../propertyeditors/localized-text-panel.fxml" />

               <!-- Icon -->
               <fx:include fx:id="icon" source="../../propertyeditors/icon-panel.fxml" />

               <CheckBox fx:id="collapsedField" mnemonicParsing="false" text="%collapsed" />

               <!-- Filter Items -->
               <fx:include fx:id="filterItems" source="filter-items-panel.fxml" />
            </VBox>
         </content>
         <padding>
            <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
         </padding>
      </ScrollPane>
   </center>
   <bottom>
      <ToolBar nodeOrientation="RIGHT_TO_LEFT" styleClass="footer-toolbar" BorderPane.alignment="CENTER">
         <items>
            <Button fx:id="okButton" defaultButton="true" mnemonicParsing="false" onAction="#onDialogSubmit" styleClass="primary-button" text="%ok" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onDialogCancel" styleClass="secondary-button" text="%cancel" />
         </items>
         <padding>
            <Insets bottom="8.0" right="8.0" />
         </padding>
      </ToolBar>
   </bottom>
</BorderPane>
