<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%link_constraints" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.relationshipmodel.LinkConstraintsPanelController">
 <BorderPane>
 <center>
  <VBox spacing="14.0">
    <children>
      <CheckBox fx:id="unboundedField" mnemonicParsing="false" text="%unbounded" />
      <VBox spacing="4.0">
        <children>
          <Label styleClass="field-label" text="%upper_limit" />
          <Spinner fx:id="upperLimitField" editable="true" />
        </children>
      </VBox>
    </children>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
