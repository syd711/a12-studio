<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane stylesheets="@../../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.masterdetailmodel.MasterDetailModelEditorController">
    <right>
        <ToolBar orientation="VERTICAL" BorderPane.alignment="CENTER">
            <items>
                <StackPane>
                    <children>
                        <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#onSettings"
                                styleClass="default-button">
                            <graphic>
                                <FontIcon iconLiteral="mdi2c-cog" iconSize="18"/>
                            </graphic>
                            <tooltip>
                                <Tooltip fx:id="settingsButtonTooltip" text="Model Settings"/>
                            </tooltip>
                        </Button>
                        <Circle fx:id="settingsErrorBadge" mouseTransparent="true" radius="4"
                                styleClass="toolbar-button-error-badge" translateX="10" translateY="-10" visible="false"
                                StackPane.alignment="CENTER"/>
                    </children>
                </StackPane>
                <Separator prefHeight="0.0" prefWidth="0.0"/>
                <fx:include fx:id="fileToolbarButtons" source="../editor-file-toolbar-buttons.fxml"/>
            </items>
        </ToolBar>
    </right>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="properties-panel" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="16.0" styleClass="field-editor">
                    <children>
                        <fx:include fx:id="masterModelReference" source="../propertyeditors/master-model-reference-panel.fxml"/>
                        <fx:include fx:id="formWidthPanel" source="../propertyeditors/form-width-panel.fxml"/>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="field-label" text="Form Mapping"/>
                                <GridPane fx:id="formMappingGrid" hgap="10.0" vgap="6.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints/>
                                    </rowConstraints>
                                    <Label styleClass="field-label" text="Document Model" GridPane.columnIndex="0"
                                           GridPane.rowIndex="0"/>
                                    <Label styleClass="field-label" text="Form Model*" GridPane.columnIndex="1"
                                           GridPane.rowIndex="0"/>
                                </GridPane>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
