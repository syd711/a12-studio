<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane resources="@/messages" alignment="CENTER_RIGHT" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.components.SearchFieldController">
   <children>
       <TextField fx:id="searchField" prefWidth="160.0" promptText="%search" styleClass="search-field" />
        <Button fx:id="resetSearchButton" accessibleText="%clear_search" managed="false" mnemonicParsing="false" onAction="#onResetSearch" styleClass="search-reset-button" visible="false">
            <graphic>
                <FontIcon iconLiteral="mdi2c-close" iconSize="12" styleClass="toolbar-icon" />
            </graphic>
            <tooltip>
                <Tooltip text="%clear_search" />
            </tooltip>
         <StackPane.margin>
            <Insets right="6.0" />
         </StackPane.margin>
        </Button>
   </children>
</StackPane>
