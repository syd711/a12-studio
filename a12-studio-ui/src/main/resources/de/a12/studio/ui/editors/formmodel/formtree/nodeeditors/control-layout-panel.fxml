<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%layout"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.formmodel.formtree.nodeeditors.ControlLayoutPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="16.0">
                <children>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="section-header" text="%offset" />
                            <HBox spacing="12.0">
                                <children>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="field-label" text="%lg" />
                                            <Spinner fx:id="offsetLgSpinner" editable="true" maxWidth="Infinity" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="field-label" text="%md" />
                                            <Spinner fx:id="offsetMdSpinner" editable="true" maxWidth="Infinity" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="field-label" text="%sm" />
                                            <Spinner fx:id="offsetSmSpinner" editable="true" maxWidth="Infinity" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="section-header" text="%span" />
                            <HBox spacing="12.0">
                                <children>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="field-label" text="%lg" />
                                            <Spinner fx:id="spanLgSpinner" editable="true" maxWidth="Infinity" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="field-label" text="%md" />
                                            <Spinner fx:id="spanMdSpinner" editable="true" maxWidth="Infinity" />
                                        </children>
                                    </VBox>
                                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="field-label" text="%sm" />
                                            <Spinner fx:id="spanSmSpinner" editable="true" maxWidth="Infinity" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
