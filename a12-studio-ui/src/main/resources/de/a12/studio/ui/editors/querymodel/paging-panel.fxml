<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%paging"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.querymodel.PagingPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="20.0">
                <children>
                    <HBox spacing="24.0">
                        <children>
                            <VBox maxWidth="200.0" spacing="4.0">
                                <children>
                                    <Label styleClass="field-label" text="%page_number" />
                                    <Spinner fx:id="pageNumberField" editable="true" maxWidth="Infinity" />
                                </children>
                            </VBox>
                            <VBox maxWidth="200.0" spacing="4.0">
                                <children>
                                    <Label styleClass="field-label" text="%page_size" />
                                    <Spinner fx:id="pageSizeField" editable="true" maxWidth="Infinity" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                    <VBox spacing="10.0">
                        <children>
                            <Label styleClass="section-header" text="%aggregation" />
                            <CheckBox fx:id="aggregateResultsField" mnemonicParsing="false" text="%aggregate_results" />
                        </children>
                    </VBox>
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
