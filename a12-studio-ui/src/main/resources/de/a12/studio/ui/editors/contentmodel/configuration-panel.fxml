<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.configuration"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <TextRow label="%content_settings.group_reference" path="groupId" types="Group,AddRowAction" prompt="%content_settings.group_id"/>
            <TextRow label="%content_settings.repeatability_in_preview" path="repeatability" types="Group"/>
            <TextRow label="%content_settings.field" path="fieldId" types="FieldOutput" prompt="%content_settings.field_id"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
