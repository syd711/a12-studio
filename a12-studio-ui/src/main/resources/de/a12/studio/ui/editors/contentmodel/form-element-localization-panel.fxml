<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.fe_localization"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <PairListRow label="%content_settings.fe_label" path="label" keys="locale,text" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup"/>
            <SwitchRow label="%content_settings.fe_hide_label" path="hideLabel" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup"/>
            <PairListRow label="%content_settings.fe_hint" path="hint" keys="locale,text" types="TextLine,TextArea,Checkbox,Switch,DatePicker,Select,AutoComplete,Radio,MultiSelect,CheckboxGroup"/>
            <PairListRow label="%content_settings.fe_placeholder" path="placeholder" keys="locale,text" types="TextLine,TextArea,DatePicker,Select,AutoComplete,MultiSelect"/>
            <PairListRow label="%content_settings.fe_suffix" path="suffix" keys="locale,text" types="TextLine"/>
            <SwitchRow label="%content_settings.fe_truncate_suffix" path="truncateSuffix" types="TextLine"/>
            <PairListRow label="%content_settings.fe_unchecked_label" path="uncheckedLabel" keys="locale,text" types="Switch"/>
            <PairListRow label="%content_settings.fe_checked_label" path="checkedLabel" keys="locale,text" types="Switch"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
