<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.accessibility"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <SwitchRow label="%content_settings.hide_content" path="contentHidden" types="TableHeadCell"/>
            <ToggleRow label="%content_settings.initial_focus" path="focusOnMessage" types="MessageBox" booleanValued="true" initial="false">
                <ToggleOption value="true" label="%content_settings.yes"/>
                <ToggleOption value="false" label="%content_settings.no"/>
            </ToggleRow>
            <TextRow label="%content_settings.screen_reader_column" path="screenReaderColumnRef" types="Table" prompt="%content_settings.select_a_column"/>
            <TextRow label="%content_settings.title" path="title" types="Video"/>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
