<?xml version="1.0" encoding="UTF-8"?>

<?import de.a12.studio.ui.editors.contentmodel.fields.*?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TitledPane fx:id="root" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%content_settings.variant"
            xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.contentmodel.ContentSettingsPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="2.0">
            <SettingGroup types="Button">
            <ToggleRow label="%content_settings.type" path="type" initial="button">
                <ToggleOption value="button" label="%content_settings.button"/>
                <ToggleOption value="reset" label="%content_settings.reset"/>
                <ToggleOption value="submit" label="%content_settings.submit"/>
            </ToggleRow>
            <SwitchRow label="%content_settings.primary" path="primary"/>
            <SwitchRow label="%content_settings.destructive" path="destructive"/>
            <SwitchRow label="%content_settings.invert" path="invert"/>
            <SwitchRow label="%content_settings.disabled" path="disabled"/>
            </SettingGroup>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
