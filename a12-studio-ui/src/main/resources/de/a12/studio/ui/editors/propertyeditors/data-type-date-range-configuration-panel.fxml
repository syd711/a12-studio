<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%date_range_type" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.propertyeditors.DataTypeDateRangeConfigurationPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
    <Label styleClass="field-label" text="%format" />
    <HBox alignment="CENTER_LEFT" spacing="6.0">
      <children>
        <ComboBox fx:id="formatComboBox" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        <Label prefHeight="9.0" prefWidth="7.0">
           <font>
              <Font size="14.0" />
           </font>
           <tooltip>
              <Tooltip prefWidth="300.0" text="%the_chosen_format_only_defines_which_date_fragments_are_show" wrapText="true" />
           </tooltip>
           <graphic>
              <FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" />
           </graphic>
        </Label>
      </children>
    </HBox>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
