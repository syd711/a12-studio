<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.preferences.A12InstallationSettingsController">
    <top>
        <VBox BorderPane.alignment="CENTER_LEFT">
            <children>
                <Label styleClass="preference-title" text="%a12_studio_settings" />
                <Label styleClass="preference-subtitle" text="%a12_installation" />
            </children>
            <BorderPane.margin>
                <Insets bottom="12.0" left="12.0" top="12.0" />
            </BorderPane.margin>
        </VBox>
    </top>
    <center>
        <VBox spacing="6.0" BorderPane.alignment="TOP_LEFT">
            <children>
                <Label styleClass="field-label" text="%installation_folder" />
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <children>
                        <TextField fx:id="installationPathField" prefWidth="360.0" promptText="%select_the_a12_installation_folder" />
                        <Button fx:id="browseButton" onAction="#onBrowseInstallationPath" styleClass="primary-button" text="%browse" >
                <tooltip><Tooltip text="%browse_for_a12_installation_folder" /></tooltip>
            </Button>
                    </children>
                </HBox>
                <fx:include fx:id="errorContainer" source="../components/error-container.fxml">
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                </fx:include>
            </children>
            <padding>
                <Insets left="12.0" right="12.0" top="8.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
