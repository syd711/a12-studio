<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="10.0" styleClass="tree-filter-popup" stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.editors.documentmodel.DocumentModelTreeFilterController">
   <padding>
      <Insets bottom="12.0" left="14.0" right="14.0" top="12.0" />
   </padding>
   <children>
      <HBox spacing="28.0">
         <children>
            <VBox spacing="6.0" minWidth="230.0">
               <children>
                  <Label styleClass="tree-filter-section" text="%document_model_tree_filter.search_in" />
                  <HBox spacing="14.0">
                     <children>
                        <RadioButton fx:id="searchInNameRadio" mnemonicParsing="false" selected="true" text="%document_model_tree_filter.search_in.name">
                           <toggleGroup>
                              <ToggleGroup fx:id="searchInGroup" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton fx:id="searchInIdRadio" mnemonicParsing="false" text="%document_model_tree_filter.search_in.id" toggleGroup="$searchInGroup" />
                        <RadioButton fx:id="searchInLabelRadio" mnemonicParsing="false" text="%document_model_tree_filter.search_in.label" toggleGroup="$searchInGroup" />
                     </children>
                  </HBox>
                  <CheckBox fx:id="onlyAnnotatedCheckBox" mnemonicParsing="false" text="%document_model_tree_filter.annotated_only">
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                  </CheckBox>
                  <Label styleClass="tree-filter-section" text="%document_model_tree_filter.element_types">
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </Label>
                  <VBox fx:id="elementTypesBox" spacing="4.0" />
                  <Label styleClass="tree-filter-section" text="%document_model_tree_filter.requiredness">
                     <VBox.margin>
                        <Insets top="8.0" />
                     </VBox.margin>
                  </Label>
                  <CheckBox fx:id="alwaysRequiredCheckBox" mnemonicParsing="false" text="%document_model_tree_filter.always_required" />
                  <CheckBox fx:id="requiredIfParentFilledCheckBox" mnemonicParsing="false" text="%document_model_tree_filter.required_if_parent_filled" />
               </children>
            </VBox>
            <Separator orientation="VERTICAL" />
            <VBox spacing="6.0" minWidth="150.0">
               <children>
                  <Label styleClass="tree-filter-section" text="%document_model_tree_filter.field_types" />
                  <VBox fx:id="fieldTypesBox" spacing="4.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Separator />
      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="resetButton" mnemonicParsing="false" onAction="#onReset" styleClass="secondary-button" text="%document_model_tree_filter.reset" />
         </children>
      </HBox>
   </children>
</VBox>
