<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="base-component, preferences-overlay" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.preferences.PreferencesController">
    <top>
        <BorderPane styleClass="window-header" BorderPane.alignment="CENTER">
            <left>
                <Label styleClass="window-header-title" text="Preferences" textFill="WHITE" BorderPane.alignment="CENTER_LEFT">
                    <BorderPane.margin>
                        <Insets left="12.0" top="6.0" bottom="6.0" />
                    </BorderPane.margin>
                </Label>
            </left>
            <right>
                <Button mnemonicParsing="false" onAction="#onClose" prefHeight="24.0" prefWidth="24.0" styleClass="header-button" BorderPane.alignment="CENTER">
                    <graphic>
                        <FontIcon iconLiteral="mdi2c-close" iconSize="16" styleClass="header-icon" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Close" />
                    </tooltip>
                    <BorderPane.margin>
                        <Insets right="6.0" top="2.0" />
                    </BorderPane.margin>
                </Button>
            </right>
        </BorderPane>
    </top>
    <left>
        <ListView fx:id="categoryList" prefWidth="200.0" styleClass="sidebar-panel" BorderPane.alignment="CENTER" />
    </left>
    <center>
        <StackPane fx:id="contentStack" styleClass="properties-panel" BorderPane.alignment="CENTER" />
    </center>
</BorderPane>
