<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="preferences-overlay" stylesheets="@../stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.preferences.PreferencesController">
    <center>
        <HBox alignment="TOP_CENTER">
            <children>
            <BorderPane prefHeight="200.0" prefWidth="200.0">
               <center>
                  <ScrollPane hbarPolicy="NEVER" maxWidth="300.0" minWidth="300.0" prefWidth="300.0" styleClass="preferences-nav" BorderPane.alignment="CENTER">
                     <content>
                            <VBox fx:id="navigationBox" maxWidth="300.0" minWidth="300.0" prefWidth="300.0">
                                <children>
                              <VBox>
                                 <children>
                                    <Label styleClass="preference-section" text="A12 STUDIO SETTINGS">
                                       <VBox.margin>
                                          <Insets bottom="6.0" />
                                       </VBox.margin>
                                    </Label>
                                    <VBox spacing="3.0">
                                       <children>
                                                <Button fx:id="modelVersionBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onModelVersion" styleClass="preference-button" text="Model Version" />
                                                <Button fx:id="a12InstallationBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onA12Installation" styleClass="preference-button" text="A12 Installation" />
                                                <Button fx:id="previewSettingsBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onPreviewSettings" styleClass="preference-button" text="Preview Settings" />
                                                <Button fx:id="shortcutsBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onShortcuts" styleClass="preference-button" text="Shortcuts" />
                                       </children>
                                    </VBox>
                                 </children>
                                 <VBox.margin>
                                    <Insets top="24.0" />
                                 </VBox.margin>
                              </VBox>
                              <VBox fx:id="projectSettingsNav">
                                 <children>
                                    <Label styleClass="preference-section" text="PROJECT SETTINGS">
                                       <VBox.margin>
                                          <Insets bottom="6.0" top="24.0" />
                                       </VBox.margin>
                                    </Label>
                                    <VBox spacing="3.0">
                                       <children>
                                                <Button fx:id="generalSettingsBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onGeneralSettings" styleClass="preference-button" text="General" />
                                                <Button fx:id="advancedSettingsBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onAdvancedSettings" styleClass="preference-button" text="Advanced Settings" />
                                                <Button fx:id="aiSettingsBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onAiSettings" styleClass="preference-button" text="AI Settings" />
                                                <Button fx:id="annotationSetsBtn" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#onAnnotationSets" styleClass="preference-button" text="Annotation Sets" />
                                       </children>
                                    </VBox>
                                 </children>
                              </VBox>
                                </children>
                                <padding>
                                    <Insets left="18.0" />
                                </padding>
                            </VBox>
                     </content>
                  </ScrollPane>
               </center>
               <HBox.margin>
                  <Insets top="24.0" />
               </HBox.margin>
            </BorderPane>
                <BorderPane maxWidth="900.0" minWidth="900.0" prefWidth="900.0">
                    <center>
                        <StackPane fx:id="contentStack" maxWidth="900.0" minWidth="900.0" prefWidth="900.0" styleClass="preferences-content" BorderPane.alignment="CENTER">
                     <BorderPane.margin>
                        <Insets top="32.0" />
                     </BorderPane.margin>
                     <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                     </padding></StackPane>
                    </center>
                </BorderPane>
                <VBox alignment="TOP_CENTER">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onClose" styleClass="ghost-button-default">
                            <graphic>
                                <FontIcon iconColor="#272828" iconLiteral="mdi2c-close-circle-outline" iconSize="48" />
                            </graphic>
                        </Button>
                    </children>
                    <HBox.margin>
                        <Insets left="18.0" top="32.0" />
                    </HBox.margin>
                </VBox>
            </children>
        </HBox>
    </center>
   <padding>
      <Insets bottom="12.0" />
   </padding>
</BorderPane>
