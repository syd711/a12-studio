    <Label prefWidth="90.0" text="Data Type*" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
    <ComboBox fx:id="dataTypeComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <HBox spacing="15.0" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="4">
