  <GridPane hgap="10.0" vgap="8.0">
    <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <columnConstraints>
      <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
      <ColumnConstraints hgrow="ALWAYS" />
      <ColumnConstraints minWidth="90.0" prefWidth="90.0" />
      <ColumnConstraints hgrow="ALWAYS" />
