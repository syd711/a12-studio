<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@../../stylesheet.css" text="%multi_selection" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.overviewmodel.OverviewMultiSelectionPanelController">
    <BorderPane>
        <top>
            <fx:include fx:id="errorContainer" source="../../components/error-container.fxml" BorderPane.alignment="CENTER" />
        </top>
        <center>
            <VBox spacing="10.0">
                <children>
                    <GridPane hgap="10.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3" />
                        </columnConstraints>
                        <children>
                            <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="field-label" text="%collapse_option" />
                                    <ComboBox fx:id="collapseOptionField" editable="false" maxWidth="Infinity" />
                                </children>
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="field-label" text="%counter_option" />
                                    <ComboBox fx:id="counterOptionField" editable="false" maxWidth="Infinity" />
                                </children>
                            </VBox>
                            <VBox spacing="4.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <children>
                                    <Label styleClass="field-label" text="%selection_area" />
                                    <ComboBox fx:id="selectionAreaField" editable="false" maxWidth="Infinity" />
                                </children>
                            </VBox>
                        </children>
                    </GridPane>

                    <TitledPane fx:id="clearConfirmationPane" maxWidth="Infinity" styleClass="titled-pane-child" text="%clear_selection_confirmation">
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <CheckBox fx:id="clearConfirmationField" mnemonicParsing="false" text="%display_confirmation_before_clearing_selected_rows" />
                                <VBox fx:id="clearConfirmationDetails" spacing="10.0">
                                    <children>
                                        <fx:include fx:id="clearConfirmationTitle" source="../propertyeditors/localized-text-panel.fxml" styleClass="titled-pane-sub-child" />
                                        <fx:include fx:id="clearConfirmationMessage" source="../propertyeditors/localized-text-panel.fxml" styleClass="titled-pane-sub-child" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </TitledPane>

                    <TitledPane fx:id="actionsPane" maxWidth="Infinity" styleClass="titled-pane-child" text="%actions_for_multi_selection">
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <HBox fx:id="actionColumnHeaders" spacing="10.0">
                                    <children>
                                        <Label prefWidth="18.0" text="" />
                                        <Label styleClass="field-label" prefWidth="160.0" text="%event" />
                                        <Label styleClass="field-label" prefWidth="90.0" text="%priority" />
                                        <Label styleClass="field-label" prefWidth="90.0" text="%destructive" />
                                        <Label styleClass="field-label" prefWidth="120.0" text="%icon" />
                                    </children>
                                </HBox>
                                <VBox fx:id="actionRows" spacing="8.0" />
                                <Label fx:id="actionsEmptyLabel" styleClass="placeholder-label" text="%no_actions_defined" />
                                <Button fx:id="addActionButton" mnemonicParsing="false" onAction="#onAddAction" styleClass="primary-button" text="%add_action" >
                <graphic><FontIcon styleClass="button-icon" iconLiteral="mdi2p-plus" iconSize="16" /></graphic>
                <tooltip><Tooltip text="%add_action" /></tooltip>
            </Button>
                            </children>
                        </VBox>
                    </TitledPane>
                </children>
            </VBox>
        </center>
    </BorderPane>
</TitledPane>
