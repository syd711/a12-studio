<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" styleClass="root" stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.RootController">
   <top>
       <fx:include fx:id="header" source="scene-header.fxml" />
   </top>
   <center>
      <StackPane fx:id="rootStack" BorderPane.alignment="CENTER">
         <children>
            <BorderPane prefHeight="200.0" prefWidth="200.0">
               <top>
                  <fx:include fx:id="menuBar" source="scene-menu-bar.fxml" BorderPane.alignment="CENTER" />
               </top>
               <center>
                  <SplitPane fx:id="centerSplitPane" orientation="VERTICAL" BorderPane.alignment="CENTER">
                     <items>
                        <StackPane fx:id="main" minHeight="150.0">
                           <children>
                              <BorderPane>
                                 <center>
                                    <Label text="%open_project_from_the_menu" BorderPane.alignment="CENTER" />
                                 </center>
                              </BorderPane>
                              <SplitPane fx:id="mainSplitPane" dividerPositions="0.3" visible="false" managed="false">
                                 <items>
                                    <fx:include fx:id="projectTree" source="projecttree/scene-project-tree.fxml" />
                                    <fx:include fx:id="tabPane" source="tabs/scene-tab-pane.fxml" />
                                 </items>
                              </SplitPane>
                           </children>
                        </StackPane>

                        <!-- Docked console panel – added to the SplitPane's items only while docked and visible;
                             see RootController.setConsolePanelVisible(). -->
                        <BorderPane fx:id="consoleArea" styleClass="console-panel" minHeight="100.0" prefHeight="220.0">
                           <top>
                              <ToolBar styleClass="console-toolbar" BorderPane.alignment="CENTER">
                                 <items>
                                    <Button fx:id="dockedDeployBtn" accessibleText="%deploy_models" disable="true" mnemonicParsing="false" onAction="#onDockedDeploy" styleClass="menu-bar-button, deploy-models-button, preview-app-button">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2c-cloud-upload-outline" iconSize="18" styleClass="toolbar-icon" />
                                       </graphic>
                                       <tooltip><Tooltip text="%deploy_models" /></tooltip>
                                    </Button>
                                    <Button fx:id="dockedLaunchBtn" accessibleText="%launch_preview_app" mnemonicParsing="false" onAction="#onDockedLaunch" styleClass="menu-bar-button, launch-preview-app-button, preview-app-button">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2p-play" iconSize="18" styleClass="toolbar-icon" />
                                       </graphic>
                                       <tooltip><Tooltip text="%launch_preview_app" /></tooltip>
                                    </Button>
                                    <Button fx:id="dockedStopBtn" accessibleText="%stop_preview_app" disable="true" mnemonicParsing="false" onAction="#onDockedStop" styleClass="menu-bar-button, stop-preview-app-button, preview-app-button">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2s-stop" iconSize="18" styleClass="toolbar-icon" />
                                       </graphic>
                                       <tooltip><Tooltip text="%stop_preview_app" /></tooltip>
                                    </Button>
                                    <Label fx:id="dockedStateLabel" styleClass="console-state-label">
                                       <HBox.margin>
                                          <Insets left="6.0" />
                                       </HBox.margin>
                                    </Label>
                                    <!-- spacer -->
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button fx:id="minimizeConsoleBtn" accessibleText="%minimize_console" mnemonicParsing="false" onAction="#onMinimizeConsole" styleClass="menu-bar-button">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2w-window-minimize" iconSize="18" styleClass="toolbar-icon" />
                                       </graphic>
                                       <tooltip><Tooltip text="%minimize_console" /></tooltip>
                                    </Button>
                                    <Button fx:id="undockBtn" accessibleText="%undock_console" mnemonicParsing="false" onAction="#onUndockConsole" styleClass="menu-bar-button">
                                       <graphic>
                                          <FontIcon iconLiteral="mdi2d-dock-window" iconSize="18" styleClass="toolbar-icon" />
                                       </graphic>
                                       <tooltip><Tooltip text="%undock_console" /></tooltip>
                                    </Button>
                                 </items>
                              </ToolBar>
                           </top>
                           <center>
                              <TextArea fx:id="dockedLogArea" editable="false" wrapText="false" styleClass="console-text-area" BorderPane.alignment="CENTER" />
                           </center>
                        </BorderPane>
                     </items>
                  </SplitPane>
               </center>
                <bottom>
                    <fx:include fx:id="footer" source="scene-footer.fxml" />
                </bottom>
            </BorderPane>
         </children>
      </StackPane>
   </center>
</BorderPane>
