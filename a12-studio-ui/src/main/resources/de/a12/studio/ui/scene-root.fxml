<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane fx:id="root" styleClass="root" stylesheets="@stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.RootController">
   <top>
       <fx:include fx:id="header" source="scene-header.fxml" />
   </top>
   <center>
      <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <top>
            <fx:include fx:id="menuBar" source="scene-menu-bar.fxml" BorderPane.alignment="CENTER" />
         </top>
         <center>
            <SplitPane fx:id="mainSplitPane" dividerPositions="0.3" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <items>
                  <fx:include fx:id="projectTree" source="projecttree/scene-project-tree.fxml" />
                  <fx:include fx:id="tabPane" source="tabs/scene-tab-pane.fxml" />
               </items>
            </SplitPane>
         </center>
      </BorderPane>
   </center>
    <bottom>
        <fx:include fx:id="footer" source="scene-footer.fxml" />
    </bottom>
</BorderPane>
