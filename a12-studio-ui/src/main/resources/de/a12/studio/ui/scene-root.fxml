<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="root" styleClass="root" stylesheets="@/de/a12/studio/ui/stylesheet.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.a12.studio.ui.RootController">
   <top>
       <fx:include fx:id="header" source="scene-header.fxml" />
   </top>
   <center>
      <StackPane fx:id="rootStack" BorderPane.alignment="CENTER">
         <children>
            <BorderPane prefHeight="200.0" prefWidth="200.0">
               <!-- drop overlay – rendered last so it appears on top; hidden until a drag enters -->

               <top>
                  <fx:include fx:id="menuBar" source="scene-menu-bar.fxml" BorderPane.alignment="CENTER" />
               </top>
               <center>
                  <SplitPane fx:id="centerSplitPane" orientation="VERTICAL" BorderPane.alignment="CENTER">
                     <items>
                        <StackPane fx:id="main" minHeight="150.0">
                           <children>
                              <BorderPane>
                                 <center>
                                    <Label text="%open_project_from_the_menu" BorderPane.alignment="CENTER" />
                                 </center>
                              </BorderPane>
                              <SplitPane fx:id="mainSplitPane" dividerPositions="0.3" visible="false" managed="false">
                                 <items>
                                    <fx:include fx:id="projectTree" source="projecttree/scene-project-tree.fxml" />
                                    <fx:include fx:id="tabPane" source="tabs/scene-tab-pane.fxml" />
                                 </items>
                              </SplitPane>
                           </children>
                        </StackPane>

                        <!-- Docked console panel – added to the SplitPane's items only while docked and visible;
                             see RootController.setConsolePanelVisible(). -->
                        <fx:include fx:id="consolePanel" source="previewapp/scene-preview-app-console-docked.fxml" />
                     </items>
                  </SplitPane>
               </center>
                <bottom>
                    <fx:include fx:id="footer" source="scene-footer.fxml" />
                </bottom>
            </BorderPane>

            <!-- ================================================================
                 File-drop overlay – covers the entire rootStack while a drag is
                 in progress; hidden (not managed) by default.
                 ============================================================== -->
            <StackPane fx:id="fileDropOverlay" styleClass="file-drop-overlay"
                       visible="false" managed="false" pickOnBounds="true">
               <children>
                  <VBox fx:id="fileDropZone" styleClass="file-drop-overlay-border"
                        alignment="CENTER" spacing="16" maxWidth="380" maxHeight="260">
                     <padding>
                        <Insets top="48" right="48" bottom="48" left="48" />
                     </padding>
                     <children>
                        <FontIcon fx:id="fileDropIcon" iconLiteral="mdi2f-file-import-outline"
                                  styleClass="file-drop-icon" />
                        <Label fx:id="fileDropLabel" text="%file_drop_hint"
                               styleClass="file-drop-label" wrapText="true"
                               textAlignment="CENTER" />
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </StackPane>
   </center>
</BorderPane>
