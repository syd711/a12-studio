<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<TitledPane fx:id="root" expanded="true" maxWidth="Infinity" stylesheets="@/de/a12/studio/ui/stylesheet.css" text="%accessibility" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="de.a12.studio.ui.editors.treemodel.TreeAccessibilityPanelController">
 <BorderPane>
 <center>
  <VBox spacing="10.0">
   <children>
    <CheckBox fx:id="hideLabelField" mnemonicParsing="false" text="%hide_label">
      <tooltip>
        <Tooltip text="%hide_label_hint" />
      </tooltip>
    </CheckBox>
    <VBox spacing="2.0">
     <children>
      <HBox alignment="CENTER_LEFT" spacing="6.0">
       <Label styleClass="field-label" text="%tree_accessibility_panel.screen_reader_column" />
       <Label>
        <graphic><FontIcon iconLiteral="mdi2h-help-circle-outline" iconSize="18" /></graphic>
        <tooltip><Tooltip prefWidth="300.0" text="%tree_accessibility_panel.screen_reader_column_hint" wrapText="true" /></tooltip>
       </Label>
      </HBox>
      <ComboBox fx:id="screenReaderColumnField" editable="false" prefWidth="240.0" />
     </children>
    </VBox>
   </children>
  </VBox>
 </center>
 <top>
    <fx:include fx:id="errorContainer" source="/de/a12/studio/ui/components/error-container.fxml" BorderPane.alignment="CENTER" />
 </top>
 </BorderPane>
</TitledPane>
