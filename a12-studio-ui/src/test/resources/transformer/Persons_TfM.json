        "OriginalPath": "/EnrollmentCertificate/IdNr",
        "NewElementName": "TaxId"
      }
    ],
    "DeletePaths": [
      {
        "path": "/EnrollmentCertificate/CreationDate"
      }
    ],
    "PatternErrors": [
      {
        "pattern": "\\d{11}",
        "action": "REPLACE",
        "replacement": "[0-9]{11}",
        "errors": [
          {
            "locale": "en",
            "text": "Eleven digits"
          }
        ]
      }
    ],
    "EnumLabels": [
      {
        "value": "BW",
        "replacements": [
          {
