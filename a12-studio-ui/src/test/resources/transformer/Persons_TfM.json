    },
    "TypeMapping": [
      {
        "xsdType": "custom_AmountWithTwoDigits",
        "a12Type": "NumberType",
        "NumberType": {
          "minFractionalDigits": 2,
          "maxFractionalDigits": 2,
          "trait": "Amount"
        }
      },
      {
        "xsdType": "custom_TaxIDNr",
        "a12Type": "StringType",
        "StringType": {
          "minLength": 11,
          "maxLength": 11
        }
      }
    ],
    "RenamePaths": [
