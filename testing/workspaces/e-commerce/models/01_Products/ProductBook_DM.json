              },
              {
                "type": "Computation",
                "id": "computation_3c17e",
                "name": "TypeComp",
                "Computation": {
                  "computedFieldRelPath": "../Common/Type",
                  "computationAlternatives": [
                    {
                      "operation": "\"Book\"",
                      "precondition": "FieldFilled(Common/Name)"
                    }
                  ],
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "error text for computation of TypeComp"
                    },
                    {
                      "locale": "de",
                      "text": "error text for computation of TypeComp"
                    }
                  ]
                }
              },
              {
                "type": "Computation",
                "id": "computation_3492e",
                "name": "Helper_RefreshPriceAutoComp",
                "Computation": {
                  "computedFieldRelPath": "../Common/Helper_RefreshPriceAuto",
                  "computationAlternatives": [
                    {
                      "operation": "True",
                      "precondition": "GroupFilled(Common/General) or\r\nGroupFilled(BookProperties)"
                    }
                  ],
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "error text for computation of Helper_RefreshPriceAutoComp"
                    },
                    {
                      "locale": "de",
                      "text": "error text for computation of Helper_RefreshPriceAutoComp"
                    }
                  ]
                }
              },
              {
                "type": "Computation",
                "id": "computation_a0dcc",
                "name": "NameComp",
                "Computation": {
                  "computedFieldRelPath": "../Common/Name",
                  "computationAlternatives": [
                    {
                      "operation": "FirstFilledValue(BookProperties/Authors*/AuthorName) + \": \"+ [BookProperties/Title]",
                      "precondition": "NumberOfFilledFields(BookProperties/Authors*/AuthorName)==1 And\r\nFieldFilled(BookProperties/Title)"
                    },
                    {
                      "operation": "FirstFilledValue(BookProperties/Authors*/AuthorName) + \" (et. al.): \"+ [BookProperties/Title]",
                      "precondition": "NumberOfFilledFields(BookProperties/Authors*/AuthorName)>1 And\r\nFieldFilled(BookProperties/Title)"
                    },
                    {
                      "operation": "FirstFilledValue(BookProperties/Authors*/AuthorName) + \": <Unknown Title>\"",
                      "precondition": "NumberOfFilledFields(BookProperties/Authors*/AuthorName) ==1 And\r\nFieldNotFilled(BookProperties/Title)"
                    },
                    {
                      "operation": "FirstFilledValue(BookProperties/Authors*/AuthorName) + \" (et. al.): <Unknown Title>\"",
                      "precondition": "NumberOfFilledFields(BookProperties/Authors*/AuthorName) >1 And\r\nFieldNotFilled(BookProperties/Title)"
                    },
                    {
                      "operation": "\"<Unknown Author>: \" + [BookProperties/Title]",
                      "precondition": "NoFieldFilled(BookProperties/Authors*/AuthorName) And\r\nFieldFilled(BookProperties/Title)"
                    }
                  ],
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "error text for computation of NameComp"
                    },
                    {
                      "locale": "de",
                      "text": "error text for computation of NameComp"
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_39bf1",
                "name": "ValidBook_ERPID",
                "Rule": {
                  "errorEntityRelPath": "../Common/General/ERP_ID",
                  "errorCode": "Error rule_39bf1",
                  "errorCondition": "RangeAsString(Common/General/ERP_ID,1,3)!=\"Bk_\"",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "The ERP ID of Books must start with Bk_"
                    },
                    {
                      "locale": "de",
                      "text": "Die ERP IDs von Büchern muss mit Bk_ beginnen."
                    }
                  ]
                }
              },
              {
                "type": "Computation",
                "id": "computation_791b2",
                "name": "HasMatureContentComp",
                "Computation": {
                  "computedFieldRelPath": "../Common/General/HasMatureContent",
                  "computationAlternatives": [
                    {
                      "operation": "True",
                      "precondition": "FieldFilled(BookProperties/MaturityRating) And\r\n[BookProperties/MaturityRating]==\"mature\""
                    }
                  ],
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "error text for computation of HasMatureContentComp"
                    },
                    {
                      "locale": "de",
                      "text": "error text for computation of HasMatureContentComp"
                    }
                  ]
                }
              }
