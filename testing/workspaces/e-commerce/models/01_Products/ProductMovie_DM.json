                "type": "Computation",
                "id": "computation_79fcb",
                "name": "HasMatureContentComp",
                "Computation": {
                  "computedFieldRelPath": "../Common/General/HasMatureContent",
                  "computationAlternatives": [
                    {
                      "operation": "True",
                      "precondition": "FieldFilled(MovieProperties/PG_Rating) and\r\nFieldValueIncludedInValueList(MovieProperties/PG_Rating, \"NC-17\",\"R\", \"M\", \"M/PG\",\"TV-MA\")"
                    }
