                "name": "ValidMovie_ERPID",
                "Rule": {
                  "errorEntityRelPath": "../Common/General/ERP_ID",
                  "errorCode": "Error rule_a3432",
                  "errorCondition": "RangeAsString(Common/General/ERP_ID,1,3)!=\"M23\"",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "The ERP ID of Movies must start with M23."
                    },
                    {
                      "locale": "de",
                      "text": "Die ERP IDs von Filmen muss mit M23 beginnen."
                    }
                  ]
