        {
          "type": "Group",
          "id": "group_8ec1f",
          "name": "Product",
          "Group": {
            "repeatability": 1,
            "elements": [
              {
                "type": "Group",
                "id": "include_common",
                "name": "Common",
                "Group": {
                  "repeatability": 1,
                  "includeConfig": {
                    "reference": "Product_Common_DM"
                  }
                }
              },
              {
                "type": "Group",
                "id": "group_86357",
                "name": "BundleProperties",
                "Group": {
                  "repeatability": 1,
                  "elements": [
                    {
                      "type": "Field",
                      "id": "field_48a81",
                      "name": "PricingMethod",
                      "Field": {
                        "fieldType": {
                          "type": "EnumerationType",
                          "EnumerationType": {
                            "values": [
                              {
                                "value": "sum",
                                "label": [
                                  {
                                    "locale": "en",
                                    "text": "Sum of Item Prices"
                                  },
                                  {
                                    "locale": "de",
                                    "text": "Summe der Einzelpreise"
                                  }
                                ]
                              },
                              {
                                "value": "premium",
                                "label": [
                                  {
                                    "locale": "en",
                                    "text": "Sum with Premium"
                                  },
                                  {
                                    "locale": "de",
                                    "text": "Summe mit Aufschlag"
                                  }
                                ]
                              },
                              {
                                "value": "fixed",
                                "label": [
                                  {
                                    "locale": "en",
                                    "text": "Fixed Price"
                                  },
                                  {
                                    "locale": "de",
                                    "text": "Fixpreis"
                                  }
                                ]
                              }
                            ]
                          }
                        },
                        "label": [
                          {
                            "locale": "en",
                            "text": "Pricing Method"
                          },
                          {
                            "locale": "de",
                            "text": "Preisberechnung"
                          }
                        ]
                      }
                    },
                    {
                      "type": "Computation",
                      "id": "computation_5090e",
                      "name": "setHelper_CurrentPriceDeterminedBySubTypeCalculation",
                      "Computation": {
                        "computedFieldRelPath": "../../Common/Helper_CurrentPriceDeterminedBySubTypeCalculation",
                        "computationAlternatives": [
                          {
                            "operation": "True",
                            "precondition": "FieldFilled(PricingMethod) and\r\n[PricingMethod]!=\"fixed\""
                          }
                        ],
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "error text for computation of setHelper_CurrentPriceDeterminedBySubTypeCalculation"
                          },
                          {
                            "locale": "de",
                            "text": "error text for computation of setHelper_CurrentPriceDeterminedBySubTypeCalculation"
                          }
                        ]
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_1e65e",
                      "name": "PricingSumOfItemPrices",
                      "Field": {
                        "fieldType": {
                          "type": "TypeDefType",
                          "TypeDefType": {
                            "typeDefinitionId": "typedef_735f62a5-c8e9-4fd5-a286-eac5bf3c4b2c"
                          }
                        },
                        "label": [
                          {
                            "locale": "en",
                            "text": "Sum of Item Prices"
                          },
                          {
                            "locale": "de",
                            "text": "Summe der Einzelpreise"
                          }
                        ]
                      }
                    },
                    {
                      "type": "Field",
                      "id": "field_c6f04",
                      "name": "PricingPremium",
                      "Field": {
                        "fieldType": {
                          "type": "NumberType",
                          "NumberType": {
                            "minValue": -99,
                            "maxValue": 500,
                            "trait": "percent"
                          }
                        },
                        "label": [
                          {
                            "locale": "en",
                            "text": "Premium"
                          },
                          {
                            "locale": "de",
                            "text": "Aufschlag"
                          }
                        ]
                      }
                    },
                    {
                      "type": "Computation",
                      "id": "computation_2e865",
                      "name": "CurrentPriceComp",
                      "Computation": {
                        "computedFieldRelPath": "../../Common/CurrentPrice",
                        "commonPrecondition": "FieldFilled(../Common/Helper_CurrentPriceDeterminedBySubTypeCalculation)",
                        "computationAlternatives": [
                          {
                            "operation": "RoundAccounting([PricingSumOfItemPrices] * {1 + [PricingPremium]/100},2)",
                            "precondition": "[PricingMethod]==\"premium\""
                          },
                          {
                            "operation": "[PricingSumOfItemPrices]",
                            "precondition": "[PricingMethod]==\"fixed\""
                          },
                          {
                            "operation": "RoundAccounting([PricingSumOfItemPrices],2)",
                            "precondition": "[PricingMethod]==\"sum\""
                          }
                        ],
                        "errorMessage": [
                          {
                            "locale": "en",
                            "text": "error text for computation of CurrentPriceComp"
                          },
                          {
                            "locale": "de",
                            "text": "error text for computation of CurrentPriceComp"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "type": "Computation",
                "id": "computation_96c8e",
                "name": "TypeComp",
                "Computation": {
                  "computedFieldRelPath": "../Common/Type",
                  "computationAlternatives": [
                    {
                      "operation": "\"Bundle\"",
                      "precondition": "FieldFilled(Common/Name)"
                    }
                  ],
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "error text for computation of TypeComp"
                    },
                    {
                      "locale": "de",
                      "text": "error text for computation of TypeComp"
                    }
                  ]
                }
              },
              {
                "type": "Computation",
                "id": "computation_4e106",
                "name": "Helper_RefreshPriceAutoComp",
                "Computation": {
                  "computedFieldRelPath": "../Common/Helper_RefreshPriceAuto",
                  "computationAlternatives": [
                    {
                      "operation": "True",
                      "precondition": "GroupFilled(Common/General) or\r\nGroupFilled(BundleProperties)"
                    }
                  ],
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "error text for computation of Helper_RefreshPriceAutoComp"
                    },
                    {
                      "locale": "de",
                      "text": "error text for computation of Helper_RefreshPriceAutoComp"
                    }
                  ]
                }
              },
              {
                "type": "Rule",
                "id": "rule_a967b",
                "name": "ValidBundle_ERPID",
                "Rule": {
                  "errorEntityRelPath": "../Common/General/ERP_ID",
                  "errorCode": "Error rule_a967b",
                  "errorCondition": "RangeAsString(Common/General/ERP_ID,1,3)!=\"BD_\"",
                  "severity": "ERROR",
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "The ERP ID of Bundles must start with BD_."
                    },
                    {
                      "locale": "de",
                      "text": "Die ERP IDs von Paketen muss mit BD_ beginnen."
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
