  "content": {
    "modelInfo": {
      "name": "Invoice_DM",
      "immutable": false,
      "comment": "model based on the invoice training exercise"
    },
    "modelConfig": {
      "timeZone": "UTC",
      "decimalSeparator": ".",
      "conditionLanguage": {
        "code": "en_US"
      }
    },
    "modelRoot": {
      "rootGroups": [
        {
          "type": "Group",
          "id": "G2",
          "name": "Invoice",
          "externalDescription": [
            {
              "locale": "en",
              "text": "Invoice"
            },
            {
              "locale": "de",
              "text": "Rechnung"
            }
          ],
          "Group": {
            "repeatability": 1,
            "elements": [
              {
                "type": "Group",
                "id": "include_7c34e",
                "name": "Addresses",
                "Group": {
                  "repeatability": 1,
                  "includeConfig": {
                    "reference": "Addresses_DM"
                  }
                }
              },
              {
                "type": "Group",
                "id": "include_d7e3e",
                "name": "Order",
                "Group": {
                  "repeatability": 1,
                  "includeConfig": {
                    "reference": "Order_DM"
                  }
                }
              },
              {
                "type": "Group",
                "id": "include_591ce",
                "name": "PaymentInfo",
                "Group": {
                  "repeatability": 1,
                  "includeConfig": {
                    "reference": "PaymentInfo_DM"
                  }
                }
              },
              {
                "type": "Field",
                "id": "F107",
                "name": "BillingAddress",
                "annotations": [
                  {
                    "name": "enable_approximate_match_search",
                    "value": "true"
                  }
                ],
                "Field": {
                  "fieldType": {
                    "type": "StringType"
                  },
                  "label": [
                    {
                      "locale": "en",
                      "text": "Billing Address"
                    },
                    {
                      "locale": "de",
                      "text": "Rechnungsadresse"
                    }
                  ],
                  "helperText": [
                    {
                      "locale": "en",
                      "text": "All address fields need to be filled out."
                    },
                    {
                      "locale": "de",
                      "text": "Alle Felder der Anschrift müssen ausgefüllt sein."
                    }
                  ]
                }
              },
              {
                "type": "Computation",
                "id": "C110",
                "name": "BillingAddressComp",
                "internalDescription": [
                  {
                    "locale": "en",
                    "text": "Concatenation"
                  },
                  {
                    "locale": "de",
                    "text": "Verkettung"
                  }
                ],
                "Computation": {
                  "computedFieldRelPath": "../BillingAddress",
                  "computationAlternatives": [
                    {
                      "operation": "[Addresses/BillingAddress/FirstName] + \" \" + [Addresses/BillingAddress/LastName] + \n\", \" + [Addresses/BillingAddress/Street] + \" \" + [Addresses/BillingAddress/Nr] + \n\" in \" + [Addresses/BillingAddress/PostalCode] + \", \" + [Addresses/BillingAddress/City]",
                      "precondition": "FieldFilled(PaymentInfo/MethodOfPayment) \nAnd [PaymentInfo/MethodOfPayment] == \"invoice\"\nAnd AllFieldsFilled(Addresses/BillingAddress/FirstName, \n        Addresses/BillingAddress/LastName, \n        Addresses/BillingAddress/Street, \n        Addresses/BillingAddress/Nr, \n        Addresses/BillingAddress/PostalCode, \n        Addresses/BillingAddress/City) And FieldNotFilled(Addresses/BillingAddress/Company)"
                    },
                    {
                      "operation": "[Addresses/BillingAddress/Company] + \" | \" + \r\n[Addresses/BillingAddress/FirstName] + \" \" + [Addresses/BillingAddress/LastName] + \r\n\", \" + [Addresses/BillingAddress/Street] + \" \" + [Addresses/BillingAddress/Nr] + \r\n\" in \" + [Addresses/BillingAddress/PostalCode] + \", \" + [Addresses/BillingAddress/City]",
                      "precondition": "FieldFilled(PaymentInfo/MethodOfPayment) \r\nAnd [PaymentInfo/MethodOfPayment] == \"invoice\"\r\nAnd AllFieldsFilled(Addresses/BillingAddress/FirstName, \r\n        Addresses/BillingAddress/LastName, \r\n        Addresses/BillingAddress/Company,\r\n        Addresses/BillingAddress/Street, \r\n        Addresses/BillingAddress/Nr, \r\n        Addresses/BillingAddress/PostalCode, \r\n        Addresses/BillingAddress/City)"
                    },
                    {
                      "operation": "[Addresses/BillingAddress/Company] + \" | \"  + [Addresses/BillingAddress/Street] + \" \" + [Addresses/BillingAddress/Nr] + \r\n\" in \" + [Addresses/BillingAddress/PostalCode] + \", \" + [Addresses/BillingAddress/City]",
                      "precondition": "FieldFilled(PaymentInfo/MethodOfPayment) \r\nAnd [PaymentInfo/MethodOfPayment] == \"invoice\"\r\nAnd AllFieldsFilled(Addresses/BillingAddress/Company, \r\n        Addresses/BillingAddress/Street, \r\n        Addresses/BillingAddress/Nr, \r\n        Addresses/BillingAddress/PostalCode, \r\n        Addresses/BillingAddress/City) And FieldNotFilled( Addresses/BillingAddress/LastName)"
                    }
                  ],
                  "errorMessage": [
                    {
                      "locale": "en",
                      "text": "error text for computation of BillingAddressComp"
                    },
                    {
                      "locale": "de",
                      "text": "error text for computation of BillingAddressComp"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  }
